@@ -0,0 +1,105 @@
+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  startAbility,
+  enterSplit,
+  exitSplit,
+  getBounds,
+  ratioDeviation,
+  getWindowViewBounds,
+  Sid,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+} from './SplitTestHelper';
+
+/**
+ * SS_B_03 启动隐私页图标在分屏小窗口下隐藏（displayPriority 隐藏能力）
+ *
+ * 用例类型：fail_to_pass
+ */
+export default function splitImageTest() {
+  describe('SplitImage', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('SS_B_03');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'PhoneAbility');
+        // 冷启动默认进入 SafePage（全屏）。等待图标渲染稳定。
+        await driver.delayMs(1000);
+      } catch (e) {
+        err('SplitImage beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('SS_B_03');
+        await exitSplit(driver);
+        await driver.waitForIdle(2000, 3000);
+        await driver.pressBack();
+      } catch (e) {
+        err('SplitImage afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_safePage_icon_hidden_after_split', Level.LEVEL1, async (done: Function) => {
+      try {
+        // 1. 分屏前（全屏空间充足）：图标应展示——getBounds 取得到，记宽高比 R0（窗口内可见尺寸）
+        const before = await getBounds(driver, ON.id(Sid.SAFE_ICON), '图标-分屏前');
+        dbg(`SS_B_03: 分屏前图标 before=${before ? JSON.stringify(before) : 'null'}`);
+        if (before === null) {
+          // 分屏前图标就取不到：异常（全屏应展示），判失败
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const beforeH = before.bottom - before.top;
+        if (beforeH <= 0) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const r0 = (before.right - before.left) / beforeH;
+
+        // 2. 切换分屏（系统默认 1/2 比例，半屏空间不足触发隐藏能力），等待布局重排稳定
+        const splitOk = await enterSplit(driver);
+        expect(splitOk).assertTrue();
+        await driver.delayMs(1500);
+
+        // 3. 分屏后：两种正确态择一。先 getBounds 判定是否展示（隐藏后不在布局树 → null）
+        const after = await getBounds(driver, ON.id(Sid.SAFE_ICON), '图标-分屏后');
+        dbg(`SS_B_03: 分屏后图标 after=${after ? JSON.stringify(after) : 'null(已隐藏)'}`);
+        if (after === null) {
+          // 态一：图标被隐藏（不在布局树）→ 正确
+          expect(true).assertTrue();
+        } else {
+          // 态二：图标仍展示 → 聚焦窗口内实际展示效果，须同时满足两条件
+          const win = await getWindowViewBounds(driver);
+          dbg(`SS_B_03: 图标展示 win=${win ? JSON.stringify(win) : 'null'}`);
+          if (win === null) {
+            expect(false).assertTrue();
+          } else {
+            // ① 完整落在可视窗口内不被遮挡（getBounds 顶/底边在窗口范围内，同屏幕坐标基准）
+            const fullyVisible = after.top >= win.top && after.bottom <= win.bottom;
+            // ② 宽高比与分屏前一致（偏差<5%，证明未变形）
+            const afterH = after.bottom - after.top;
+            const dev = afterH > 0 ? ratioDeviation(r0, (after.right - after.left) / afterH) : Infinity;
+            dbg(`SS_B_03: fullyVisible=${fullyVisible} ratioDev=${dev.toFixed(4)} (r0=${r0.toFixed(4)})`);
+            expect(fullyVisible).assertTrue();
+            expect(dev < 0.05).assertTrue();
+          }
+        }
+      } catch (e) {
+        err('SS_B_03 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
