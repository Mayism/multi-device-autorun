+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  startAbility,
+  enterSplit,
+  getBounds,
+  clickIfExists,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  Sid,
+  exitSplit,
+} from './SplitTestHelper';
+
+/**
+ * SS_B_05 分屏下视频画面应保持正确宽高比（aspectRatio 响应式）
+ *
+ * 用例类型：fail_to_pass
+ */
+export default function splitVideoTest() {
+  describe('SplitVideo', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('SS_B_05');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'PhoneAbility');
+        // 冷启动先到 SafePage：点"同意"进入 Main
+        await clickIfExists(driver, ON.text('同意'), 'SafePage 同意');
+        await driver.delayMs(500);
+        // 切到"视频"底部 Tab → 默认进入"精选"（VideoType.CHOICE）
+        await clickIfExists(driver, ON.text('视频'), '视频tab');
+        // 等待首个视频加载、首帧渲染稳定
+        await driver.delayMs(2000);
+      } catch (e) {
+        err('SplitVideo beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('SS_B_05');
+        await exitSplit(driver);
+        await driver.waitForIdle(2000, 3000);
+        await driver.pressBack();
+        await driver.pressBack();
+      } catch (e) {
+        err('SplitVideo afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_videoKeepAspectRatio_after_split', Level.LEVEL1, async (done: Function) => {
+      try {
+        // 1. 分屏前（全屏）：取当前播放视频画面 XComponent 宽高，计算 R0
+        const before = await getBounds(driver, ON.id(Sid.VIDEO_XCOMPONENT), '视频画面-分屏前');
+        dbg(`SS_B_05: 分屏前画面 before=${before ? JSON.stringify(before) : 'null'}`);
+        if (before === null) {
+          // 画面取不到（视频未加载/未渲染）→ 无法测宽高比，判失败
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const w0 = before.right - before.left;
+        const h0 = before.bottom - before.top;
+        const r0 = w0 / h0;
+        dbg(`SS_B_05: 分屏前 w0=${w0} h0=${h0} R0=${r0}`);
+
+        // 2. 切换上下分屏（系统默认 1/2 比例），等待窗口尺寸变化稳定
+        const splitOk = await enterSplit(driver);
+        expect(splitOk).assertTrue();
+        await driver.delayMs(1500);
+
+        // 3. 分屏后：再次取画面宽高，计算 R1
+        const after = await getBounds(driver, ON.id(Sid.VIDEO_XCOMPONENT), '视频画面-分屏后');
+        dbg(`SS_B_05: 分屏后画面 after=${after ? JSON.stringify(after) : 'null'}`);
+        if (after === null) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const w1 = after.right - after.left;
+        const h1 = after.bottom - after.top;
+        const r1 = w1 / h1;
+        dbg(`SS_B_05: 分屏后 w1=${w1} h1=${h1} R1=${r1}`);
+
+        // 4. 断言分屏前后宽高比偏差 < 10%（aspectRatio 响应式，画面不变形）
+        const deviation = Math.abs(r0 - r1) / r0;
+        dbg(`SS_B_05: 偏差=${deviation}（阈值 10%）`);
+        expect(deviation < 0.1).assertTrue();
+      } catch (e) {
+        err('SS_B_05 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
