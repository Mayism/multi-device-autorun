@@ -0,0 +1,97 @@
+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  startAbility,
+  enterSplit,
+  exitSplit,
+  getBounds,
+  getRealRect,
+  clickByText,
+  flingUp,
+  Sid,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+} from './SplitTestHelper';
+
+/**
+ * SS_B_02 启动隐私页"取消"弹窗分屏后底部按钮不应与文案内容重叠
+ *
+ * 用例类型：fail_to_pass
+ */
+export default function splitDialogTest() {
+  describe('SplitDialog', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('SS_B_02');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'PhoneAbility');
+        // 冷启动默认进入 SafePage（getAgreed() 始终 false）。等待页面稳定。
+        await driver.delayMs(1000);
+        // 切换分屏（系统默认 1/2 比例）
+        const splitOk = await enterSplit(driver);
+        dbg(`SS_B_02 beforeAll: enterSplit ok=${splitOk}`);
+        // 取"取消"按钮：分屏后可能落到可视区外，先直接取，取不到则 flingUp 滚动 SafePage 查找，找到后点击触发 AgreeDialog
+        let cancelVisible = await getBounds(driver, ON.text('取消'), '取消按钮');
+        if (cancelVisible === null) {
+          dbg(`SS_B_02 beforeAll: 当前可视区未取到"取消"按钮，开始 flingUp 滚动查找`);
+          for (let i = 0; i < 4; i++) {
+            await flingUp(driver);
+            await driver.delayMs(500);
+            cancelVisible = await getBounds(driver, ON.text('取消'), '取消按钮');
+            dbg(`SS_B_02 beforeAll: 第${i + 1}次 flingUp 后取"取消"按钮=${cancelVisible === null ? 'null' : JSON.stringify(cancelVisible)}`);
+            if (cancelVisible !== null) {
+              break;
+            }
+          }
+        }
+        await clickByText(driver, '取消');
+        await driver.delayMs(1000);
+      } catch (e) {
+        err('SplitDialog beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('SS_B_02');
+        await exitSplit(driver);
+        await driver.waitForIdle(2000, 3000);
+        await driver.pressBack();
+      } catch (e) {
+        err('SplitDialog afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_dialogContent_notOverlap_with_bottomButtons_after_split', Level.LEVEL1, async (done: Function) => {
+      try {
+        // Scroll 内容区真实布局底边（componentUtils 取屏幕坐标，不受视口裁剪影响）
+        const scroll = getRealRect(Sid.AGREE_DIALOG_SCROLL);
+        // 底部按钮区顶边
+        const btnExit = await getBounds(driver, ON.text('退出应用'), '退出应用按钮');
+        dbg(`SS_B_02: scroll=${JSON.stringify(scroll)} btnExit=${JSON.stringify(btnExit)}`);
+
+        if (scroll === null || btnExit === null) {
+          // 取不到无法判定重叠，判失败
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+
+        // 断言 Scroll 底边 ≤ 按钮顶边（内容区不应延伸到按钮区之下被遮挡）
+        const scrollBottom = scroll.top + scroll.height;
+        dbg(`SS_B_02: scrollBottom=${scrollBottom} btnExit.top=${btnExit.top} (重叠=${scrollBottom > btnExit.top})`);
+        expect(scrollBottom <= btnExit.top).assertTrue();
+      } catch (e) {
+        err('SS_B_02 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
diff --git a/products/phone/src/ohosTest/ets/test/SplitImage.test.ets b/products/phone/src/ohosTest/ets/test/SplitImage.test.ets
