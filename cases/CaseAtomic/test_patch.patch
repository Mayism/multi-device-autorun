@@ -0,0 +1,106 @@
+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  On,
+  Bounds,
+  startAbility,
+  enterSplit,
+  exitSplit,
+  getBounds,
+  clickIfExists,
+  flingUp,
+  flingDown,
+  getWindowViewBounds,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+} from './SplitTestHelper';
+
+/**
+ * SS_B_01 分屏后登录页内容可上下滚动查看完整内容（不被截断）
+ *
+ * 用例类型：fail_to_pass
+ */
+export default function splitScrollTest() {
+  describe('SplitScroll', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('SS_B_01');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'PhoneAbility');
+        // 冷启动先到 SafePage：点"同意"进入 Main，"我的"tab 才可见
+        await clickIfExists(driver, ON.text('同意'), 'SafePage 同意');
+        await driver.delayMs(200);
+        // 通用前置：切到"我的"tab → 点击"点击登录"进入登录页（QuickLoginPage）
+        await clickIfExists(driver, ON.text('我的'), '我的tab');
+        await driver.delayMs(200);
+        await clickIfExists(driver, ON.text('点击登录'), '点击登录入口');
+        await driver.delayMs(200);
+      } catch (e) {
+        err('SplitScroll beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('SS_B_01');
+        await exitSplit(driver);
+        await driver.waitForIdle(2000, 3000);
+        await driver.pressBack();
+        await driver.pressBack();
+      } catch (e) {
+        err('SplitScroll afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    // 底部标记：协议勾选 Checkbox位于 Scroll 内容最底部。分屏后半屏高度下初始被截断不可见；滚到底后可见。
+    const bottomCheckbox: On = ON.type('Checkbox');
+
+    it('should_loginPage_content_scrollable_after_split', Level.LEVEL1, async (done: Function) => {
+      try {
+        // 切换分屏（系统默认 1/2 比例）。分屏本身是基础操作，失败判异常失败
+        const splitOk = await enterSplit(driver);
+        expect(splitOk).assertTrue();
+        await driver.delayMs(1000);
+
+        // 记录初始（滚前）状态：Checkbox 应不可见（适配前被截断）
+        const before = await getBounds(driver, bottomCheckbox, '协议Checkbox-before');
+        dbg(`SS_B_01: before=${before ? JSON.stringify(before) : 'null(被截断不可见)'}`);
+
+        // 反复 fling 上滑，每次滚动后判断 Checkbox 是否落入可视窗口，可见即停
+        let after: Bounds | null = null;
+        let win = await getWindowViewBounds(driver);
+        for (let i = 0; i < 4; i++) {
+          await flingUp(driver);
+          await driver.delayMs(500);
+          after = await getBounds(driver, bottomCheckbox, '协议Checkbox-after');
+          win = await getWindowViewBounds(driver);
+          if (after !== null && win !== null && after.top >= win.top && after.bottom <= win.bottom) {
+            dbg(`SS_B_01: 第${i + 1}次 flingUp 后 Checkbox 已可见 ${JSON.stringify(after)}`);
+            break;
+          }
+          dbg(`SS_B_01: 第${i + 1}次 flingUp 后 Checkbox 仍不可见 after=${after ? JSON.stringify(after) : 'null'}`);
+        }
+
+        dbg(`SS_B_01: after=${after ? JSON.stringify(after) : 'null'} win=${win ? JSON.stringify(win) : 'null'}`);
+
+        if (after === null || win === null) {
+          // 滚到底后仍取不到 Checkbox：Scroll 未生效（适配前的失败态）
+          expect(false).assertTrue();
+        } else {
+          // 断言 Checkbox 顶/底边落在可视窗口范围内
+          expect(after.top >= win.top && after.bottom <= win.bottom).assertTrue();
+        }
+      } catch (e) {
+        err('SS_B_01 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
