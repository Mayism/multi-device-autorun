diff --git a/product/phone/src/ohosTest/ets/test/TestHelper.ets b/product/phone/src/ohosTest/ets/test/TestHelper.ets
new file mode 100644
index 0000000..9051388
--- /dev/null
+++ b/product/phone/src/ohosTest/ets/test/TestHelper.ets
@@ -0,0 +1,457 @@
+/*
+ * 一多适配 UI 测试公共辅助。
+ * .test.ets 文件不能直接 import '@kit.TestKit'，故本文件统一 re-export TestKit API。
+ */
+import { expect } from '@ohos/hypium';
+import { window, componentUtils, ComponentUtils } from '@kit.ArkUI';
+import { common, Want } from '@kit.AbilityKit';
+import { abilityDelegatorRegistry, Driver, ON, On, Component, UiWindow, ResizeDirection } from '@kit.TestKit';
+import display from '@ohos.display';
+import { resourceManager } from '@kit.LocalizationKit';
+
+// ============================ 常量与类型 ============================
+
+/** 被测应用 bundleName（取自 AppScope/app.json5，接入时替换为真实包名）。 */
+export const BUNDLE_NAME = 'bjyy.1.xxxxxx';
+
+/** 主 Ability 名，与 module.json5 mainElement 一致。 */
+export const ENTRY_ABILITY = 'EntryAbility';
+
+// ============================ 断点（一多适配） ============================
+
+/**
+ * 断点分界点（vp）：SM < 600 | MD 600–840 | LG 840–1440 | XL ≥ 1440。
+ * 两端不设下限：极窄归 SM。XL 尺寸暂未实现，≥1440 一并入 LG。
+ */
+export const BP_SM_MAX = 600;
+export const BP_MD_MAX = 840;
+export const BP_LG_MAX = 1440;
+
+export type Breakpoint = 'sm' | 'md' | 'lg';
+
+/** 读取屏幕宽度（vp），基于 display 的 densityPixels 换算，不依赖被测窗口。 */
+export function getWindowWidthVp(): number {
+  const d = display.getDefaultDisplaySync();
+  const density = d.densityPixels;
+  const px = d.width;
+  const vp = density > 0 ? px / density : px;
+  console.info(`[NOTES] getWindowWidthVp: ${px}px / density=${density} → ${vp}vp`);
+  return vp;
+}
+
+/** 由窗口宽判定断点。XL 暂并入 LG。 */
+export function breakpointOf(widthVp: number): Breakpoint {
+  if (widthVp < BP_SM_MAX) {
+    return 'sm';
+  }
+  if (widthVp < BP_MD_MAX) {
+    return 'md';
+  }
+  return 'lg';
+}
+
+/** 当前断点，在 it 内部调用（此时主窗口已就绪）。读取失败回退 'sm'。 */
+export function currentBreakpoint(): Breakpoint {
+  try {
+    const bp = breakpointOf(getWindowWidthVp());
+    console.info(`[NOTES] currentBreakpoint = ${bp}`);
+    return bp;
+  } catch (e) {
+    console.error(`[NOTES] currentBreakpoint 读取失败，回退 'sm'：${(e as Error).message}`);
+    return 'sm';
+  }
+}
+
+// ============================ 设备类型（区分 PC / 平板） ============================
+
+/**
+ * 设备大类：与被测 Index.isPcLayout()/isTabletLayout() 同源（resourceManager.deviceType）。
+ * 仅靠窗口宽无法区分 PC（2in1）与平板——两者断点常同为 lg。
+ */
+export type DeviceClass = 'phone' | 'tablet' | 'pc';
+
+/** 缓存被测 ability context，避免每次读设备类型都 await。 */
+let _hostContext: common.Context | null = null;
+
+async function getHostContext(): Promise<common.Context> {
+  if (_hostContext !== null) {
+    return _hostContext;
+  }
+  const ability = await delegator.getCurrentTopAbility();
+  _hostContext = (ability.context as common.UIAbilityContext) as common.Context;
+  return _hostContext;
+}
+
+/**
+ * 当前设备大类，在 it 内部调用（startAbility 之后）。
+ * 读取失败回退 'phone'。与 Index.isPcLayout()/isTabletLayout() 判断口径一致。
+ */
+export async function currentDeviceClass(): Promise<DeviceClass> {
+  try {
+    const ctx = await getHostContext();
+    const type = ctx.resourceManager.getDeviceCapabilitySync().deviceType;
+    if (type === resourceManager.DeviceType.DEVICE_TYPE_2IN1) {
+      return 'pc';
+    }
+    if (type === resourceManager.DeviceType.DEVICE_TYPE_TABLET) {
+      return 'tablet';
+    }
+    return 'phone';
+  } catch (e) {
+    console.error(`[NOTES] currentDeviceClass 读取失败，回退 'phone'：${(e as Error).message}`);
+    return 'phone';
+  }
+}
+
+/** UiTest Rect 的本地接口（SDK Rect 类型为 any）。 */
+export interface Bounds {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+/** 组件真实布局矩形（屏幕坐标 + 尺寸）。 */
+export interface RealRect {
+  left: number;
+  top: number;
+  width: number;
+  height: number;
+}
+
+/** 被测组件测试 ID 约定。 */
+export enum Sid {
+  NOTE_LIST = 'note_list',
+  CATEGORY_TRIGGER = 'category_trigger',
+  CATEGORY_LIST = 'category_list',
+  CATEGORY_ITEM_0 = 'category_item_0',
+}
+
+// ============================ Delegator & 日志 ============================
+
+export const delegator: abilityDelegatorRegistry.AbilityDelegator = abilityDelegatorRegistry.getAbilityDelegator();
+
+/** 取被测 bundleName，优先 delegator 参数，回退模块常量。 */
+export function getBundleName(): string {
+  try {
+    const bn = abilityDelegatorRegistry.getArguments().bundleName;
+    return bn || BUNDLE_NAME;
+  } catch (e) {
+    return BUNDLE_NAME;
+  }
+}
+
+let _caseTag: string = '';
+export function setCaseTag(tag: string): void {
+  _caseTag = tag;
+}
+
+export function dbg(msg: string): void {
+  const prefix = _caseTag ? `[NOTES][${_caseTag}]` : '[NOTES]';
+  console.info(`${prefix} ${msg}`);
+}
+
+export function err(msg: string): void {
+  const prefix = _caseTag ? `[NOTES][${_caseTag}]` : '[NOTES]';
+  console.error(`${prefix} ${msg}`);
+}
+
+// ============================ 启动与主窗口 ============================
+
+let _mainWindowCache: window.Window | null = null;
+
+async function cacheMainWindow(): Promise<void> {
+  if (_mainWindowCache !== null) {
+    return;
+  }
+  try {
+    const ability = await delegator.getCurrentTopAbility();
+    const ctx = ability.context as common.UIAbilityContext;
+    _mainWindowCache = ctx.windowStage.getMainWindowSync();
+    dbg('cacheMainWindow: 已缓存主窗口');
+  } catch (e) {
+    dbg(`cacheMainWindow 失败: ${(e as Error).message}`);
+  }
+}
+
+/** 当前主窗口（同步，返回缓存值）。需在 startAbility 之后调用。 */
+export function getMainWindow(): window.Window {
+  if (_mainWindowCache === null) {
+    throw new Error('getMainWindow: 主窗口缓存未就绪，请确认 beforeAll 已 await startAbility(...)');
+  }
+  return _mainWindowCache;
+}
+
+/** 启动被测 ability、等待 UI 稳定并缓存主窗口。 */
+export async function startAbility(driver: Driver, bundleName: string, abilityName: string): Promise<void> {
+  try {
+    const want: Want = {
+      bundleName: bundleName,
+      abilityName: abilityName,
+    };
+    await delegator.startAbility(want);
+    await driver.waitForIdle(3000, 5000);
+    await cacheMainWindow();
+  } catch (e) {
+    err('startAbility 失败: ' + JSON.stringify(e));
+  }
+}
+
+// ============================ 窗口查找 ============================
+
+/** 通过 Driver 查找被测应用主窗口。 */
+export async function getUiWindow(driver: Driver): Promise<UiWindow | null> {
+  try {
+    const bn = getBundleName();
+    const win: UiWindow = await driver.findWindow({ bundleName: bn });
+    if (win === null || win === undefined) {
+      dbg(`getUiWindow: 被测窗口未找到（bundleName=${bn}）`);
+      return null;
+    }
+    return win;
+  } catch (e) {
+    dbg(`getUiWindow 异常: ${(e as Error).message}`);
+    return null;
+  }
+}
+
+/** 被测窗口屏幕绝对边界（px），与组件 getBounds() 同基准。 */
+export async function getWindowBounds(driver: Driver): Promise<Bounds | null> {
+  const uiWin = await getUiWindow(driver);
+  if (uiWin === null) {
+    dbg('getWindowBounds: 被测窗口未找到 → null');
+    return null;
+  }
+  try {
+    const b = await uiWin.getBounds() as Bounds;
+    const result: Bounds = { left: b.left, top: b.top, right: b.right, bottom: b.bottom };
+    dbg(`getWindowBounds: L=${result.left} T=${result.top} R=${result.right} B=${result.bottom} (${result.right - result.left}x${result.bottom - result.top})`);
+    return result;
+  } catch (e) {
+    dbg(`getWindowBounds 异常: ${(e as Error).message} → null`);
+    return null;
+  }
+}
+
+// ============================ 窗口尺寸（PC 自由窗口写操作） ============================
+
+/**
+ * 将被测窗口移动到 (x,y)，避免 resize 时贴屏幕边界被系统限制卡住。失败返回 false。
+ */
+export async function moveWindow(driver: Driver, x: number, y: number): Promise<boolean> {
+  const uiWin = await getUiWindow(driver);
+  if (uiWin === null) {
+    dbg(`moveWindow: 窗口未找到 → (${x},${y})`);
+    return false;
+  }
+  try {
+    await uiWin.moveTo(x, y);
+    dbg(`moveWindow: → (${x},${y})`);
+    return true;
+  } catch (e) {
+    dbg(`moveWindow 异常: ${(e as Error).message}`);
+    return false;
+  }
+}
+
+/**
+ * 调整被测窗口到目标宽高（px）。direction 指定拖拽边/角，决定窗口位置随尺寸如何变化。
+ * PC 自由窗口有系统下限（约宽 320vp / 高 72vp），过小会被系统钳制，调用方需自行校验返回尺寸。
+ */
+export async function resizeWindow(driver: Driver, width: number, height: number,
+  direction: ResizeDirection): Promise<boolean> {
+  const uiWin = await getUiWindow(driver);
+  if (uiWin === null) {
+    dbg(`resizeWindow: 窗口未找到 → ${width}x${height}`);
+    return false;
+  }
+  try {
+    await uiWin.resize(width, height, direction);
+    dbg(`resizeWindow: → ${width}x${height} dir=${direction}`);
+    return true;
+  } catch (e) {
+    dbg(`resizeWindow 异常 (可能命中系统窗口尺寸下限): ${(e as Error).message}`);
+    return false;
+  }
+}
+
+// ============================ 组件查询 ============================
+
+/** 组件边界，未找到返回 null。 */
+export async function getBounds(driver: Driver, on: On, label?: string): Promise<Bounds | null> {
+  const tag = label ?? '组件';
+  try {
+    const comp: Component = await driver.findComponent(on);
+    const r = await comp.getBounds() as Bounds;
+    const result: Bounds = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
+    dbg(`getBounds[${tag}]: L=${result.left} T=${result.top} R=${result.right} B=${result.bottom} (${result.right - result.left}x${result.bottom - result.top})`);
+    return result;
+  } catch (e) {
+    dbg(`getBounds[${tag}]: 未找到/异常, err=${(e as Error).message}`);
+    return null;
+  }
+}
+
+/** 点击组件（若存在），返回是否成功。 */
+export async function clickIfExists(driver: Driver, on: On, label?: string): Promise<boolean> {
+  const tag = label ?? '组件';
+  try {
+    const comp: Component = await driver.findComponent(on);
+    await comp.click();
+    dbg(`clickIfExists[${tag}]: 点击成功`);
+    return true;
+  } catch (e) {
+    dbg(`clickIfExists[${tag}]: 未找到/点击失败, err=${(e as Error).message}`);
+    return false;
+  }
+}
+
+/** 按文本查找并点击组件，未找到抛 Error。 */
+export async function clickByText(driver: Driver, text: string): Promise<void> {
+  try {
+    const comp: Component = await driver.findComponent(ON.text(text));
+    await comp.click();
+    dbg(`clickByText: 点击成功 text='${text}'`);
+  } catch (e) {
+    dbg(`clickByText: 点击失败/未找到 text='${text}', err=${(e as Error).message}`);
+    throw new Error(`clickByText failed: text='${text}', cause=${(e as Error).message}`);
+  }
+}
+
+/** 组件真实布局矩形，基于 componentUtils，不受视口裁剪影响。 */
+export function getRealRect(id: string): RealRect | null {
+  const tag = `getRealRect[${id}]`;
+  try {
+    const cu: ComponentUtils = getMainWindow().getUIContext().getComponentUtils();
+    const info: componentUtils.ComponentInfo = cu.getRectangleById(id);
+    const left: number = info.screenOffset.x;
+    const top: number = info.screenOffset.y;
+    const w: number = info.size.width;
+    const h: number = info.size.height;
+    dbg(`${tag}: L=${left} T=${top} ${w}x${h}`);
+    const result: RealRect = { left: left, top: top, width: w, height: h };
+    return result;
+  } catch (e) {
+    dbg(`${tag}: 异常 ${(e as Error).message}`);
+    return null;
+  }
+}
+
+// ============================ 分类可见性 ============================
+
+/**
+ * 导航到 EditCategory 页面并确保分类列表可见。
+ * 路径：点 category_trigger 打开弹窗 → 点"前往笔记分类"进入 NavDestination → 等待列表。
+ */
+export async function ensureCategoryVisible(driver: Driver): Promise<boolean> {
+  try {
+    const ok = await clickIfExists(driver, ON.id(Sid.CATEGORY_TRIGGER), '打开分类弹窗');
+    if (!ok) {
+      return false;
+    }
+    await driver.delayMs(800);
+    await clickByText(driver, '前往笔记分类');
+    await driver.delayMs(800);
+    await getBounds(driver, ON.id(Sid.CATEGORY_LIST), '分类列表');
+    await getBounds(driver, ON.id(Sid.CATEGORY_ITEM_0), '首个分类项');
+    return true;
+  } catch (e) {
+    err(`ensureCategoryVisible 异常: ${(e as Error).message}`);
+    return false;
+  }
+}
+
+// ============================ 一多适配断言 ============================
+
+/** 兜底关闭应用侧弹窗，按文案定位，找不到则忽略。 */
+export async function dismissAppDialogs(driver: Driver): Promise<void> {
+  const dismissTexts: string[] = ['取消', '以后再说', '暂不更新', '知道了', '确定'];
+  for (let i = 0; i < 2; i++) {
+    for (const text of dismissTexts) {
+      try {
+        const comp = await driver.findComponent(ON.text(text));
+        await comp.click();
+        await driver.delayMs(400);
+      } catch (_e) {
+        // 不存在则跳过
+      }
+    }
+  }
+}
+
+/** 断言笔记列表宽/窗口宽 ∈ [minR, maxR]。窗口与列表同为屏幕绝对坐标 px。 */
+export async function assertListRatio(driver: Driver, minR: number, maxR: number, label: string): Promise<void> {
+  const TOL = 0.02; // 浮点/像素取整相对容差
+  const list = await getBounds(driver, ON.id(Sid.NOTE_LIST), '笔记列表');
+  const win = await getWindowBounds(driver);
+  dbg(`${label}: list=${list ? JSON.stringify(list) : 'null'} win=${win ? JSON.stringify(win) : 'null'}`);
+  if (list === null || win === null) {
+    expect(false).assertTrue();
+    return;
+  }
+  const listW = list.right - list.left;
+  const winW = win.right - win.left;
+  const ratio = listW / winW;
+  dbg(`${label}: listW=${listW} winW=${winW} ratio=${ratio}（期望[${minR},${maxR}]）`);
+  expect(ratio >= minR - TOL).assertTrue();
+  expect(ratio <= maxR + TOL).assertTrue();
+}
+
+/** 断言分类 ListItem 宽/列表宽 ≈ expectRatio。需先 ensureCategoryVisible 打开分类列表。 */
+export async function assertItemRatio(driver: Driver, expectRatio: number, label: string): Promise<void> {
+  const TOL = 0.03; // 相对容差 ±3%
+  const visible = await ensureCategoryVisible(driver);
+  if (!visible) {
+    dbg(`${label}: 分类列表不可见，判失败`);
+    expect(false).assertTrue();
+    return;
+  }
+  const list = await getBounds(driver, ON.id(Sid.CATEGORY_LIST), '分类列表');
+  const item = await getBounds(driver, ON.id(Sid.CATEGORY_ITEM_0), '首个分类项');
+  dbg(`${label}: list=${list ? JSON.stringify(list) : 'null'} item=${item ? JSON.stringify(item) : 'null'}`);
+  if (list === null || item === null) {
+    expect(false).assertTrue();
+    return;
+  }
+  const listW = list.right - list.left;
+  const itemW = item.right - item.left;
+  const ratio = listW === 0 ? Infinity : itemW / listW;
+  const dev = Math.abs(ratio - expectRatio);
+  dbg(`${label}: listW=${listW} itemW=${itemW} ratio=${ratio}（期望${expectRatio}, 偏差=${dev}）`);
+  expect(dev <= TOL).assertTrue();
+}
+
+// ============================ 状态恢复 ============================
+
+/** 需清理的 AppStorage 运行时 key（易触发非预期跳转）。 */
+const VOLATILE_STORAGE_KEYS: string[] = [
+  'from_gesture_share',
+  'from_gesture_share_content',
+  'shared_note_payload',
+  'share_note_id',
+  'notes_embed_dirty',
+  'notes_embed_dirty_note_id',
+];
+
+/** 回退到首页根态并清理运行时 key。 */
+export async function cleanupToRoot(driver: Driver): Promise<void> {
+  try {
+    for (let i = 0; i < 3; i++) {
+      await driver.pressBack();
+      await driver.delayMs(300);
+    }
+    for (const k of VOLATILE_STORAGE_KEYS) {
+      try {
+        AppStorage.delete(k);
+      } catch (_e) {
+        // key 不存在无副作用
+      }
+    }
+    dbg('cleanupToRoot: 已回退并清理运行时 key');
+  } catch (e) {
+    err(`cleanupToRoot 异常: ${(e as Error).message}`);
+  }
+}
+
+// ============================ re-export TestKit ============================
+export { Driver, ON, On, ResizeDirection };
