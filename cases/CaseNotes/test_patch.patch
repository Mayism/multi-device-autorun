+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  startAbility,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  assertListRatio,
+  assertItemRatio,
+  dismissAppDialogs,
+  cleanupToRoot,
+  currentBreakpoint,
+  currentDeviceClass,
+} from './TestHelper';
+
+/**
+ * 套件：LG 断点（平板）一多适配用例。
+ *   - 笔记列表宽 ≤ 窗口宽 × 50%（侧栏展示）
+ *   - 分类 ListItem 宽 ≈ 分类列表宽 × 1/3（三列）
+ */
+export default function lgFailToPassTest() {
+  describe('LgFailToPass', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('LG_FAIL_TO_PASS');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'EntryAbility');
+        await driver.delayMs(1000);
+        await dismissAppDialogs(driver);
+      } catch (e) {
+        err('LgFailToPass beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('LG_FAIL_TO_PASS');
+        await cleanupToRoot(driver);
+      } catch (e) {
+        err('LgFailToPass afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    // 笔记列表（平板 LG）：列表宽/窗口宽 ∈ [0.0, 0.50]。PC 跳过（PC 为三栏中栏，非侧栏）。
+    it('should_note_list_be_side_bar_on_lg_breakpoint', Level.LEVEL1, async (done: Function) => {
+      const device = await currentDeviceClass();
+      if (currentBreakpoint() !== 'lg' || device === 'pc') {
+        dbg('LG_平板：当前断点不符或为 PC，跳过');
+        done();
+        return;
+      }
+      try {
+        await assertListRatio(driver, 0.0, 0.50, 'LG_平板');
+      } catch (e) {
+        err('LG_平板 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+
+    // 分类列表（平板 LG）：ListItem 宽/列表宽 ≈ 1/3（三列）。PC 跳过（独立 pcCategoryList UI）。
+    it('should_category_list_be_three_lanes_on_lg_breakpoint', Level.LEVEL1, async (done: Function) => {
+      const device = await currentDeviceClass();
+      if (currentBreakpoint() !== 'lg' || device === 'pc') {
+        dbg('LG_平板：当前断点不符或为 PC，跳过');
+        done();
+        return;
+      }
+      try {
+        await assertItemRatio(driver, 0.33, 'LG_平板');
+      } catch (e) {
+        err('LG_平板 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
