+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  startAbility,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  Sid,
+  Bounds,
+  getBounds,
+  getWindowBounds,
+  resizeWindow,
+  moveWindow,
+  dismissAppDialogs,
+  cleanupToRoot,
+  currentDeviceClass,
+  ResizeDirection,
+} from './TestHelper';
+
+/**
+ * 套件：PC(2in1) resize 稳定性用例（断言变化前后"不变"）。
+ *   - 窗口 resize 后笔记列表占比保持不变（drift ≤ 容差）
+ * 仅在 currentDeviceClass() === 'pc' 时执行，其余设备跳过。
+ * 与 XlFailToPass 区别：本套件断言"占比无变化"（稳定性），而非"占比落在固定区间"。
+ */
+export default function xlPassToPassTest() {
+  describe('XlPassToPass', () => {
+    let driver: Driver;
+    /** 初始窗口 bounds，afterAll 据此还原（resize 用例会改窗口尺寸）。 */
+    let initialBounds: Bounds | null = null;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('XL_PASS_TO_PASS');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'EntryAbility');
+        await driver.delayMs(1000);
+        await dismissAppDialogs(driver);
+        initialBounds = await getWindowBounds(driver);
+      } catch (e) {
+        err('XlPassToPass beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('XL_PASS_TO_PASS');
+        // 还原窗口尺寸（resize 用例改动过），避免影响后续用例
+        if (initialBounds !== null) {
+          const w = initialBounds.right - initialBounds.left;
+          const h = initialBounds.bottom - initialBounds.top;
+          await moveWindow(driver, initialBounds.left, initialBounds.top);
+          await resizeWindow(driver, w, h, ResizeDirection.RIGHT_DOWN);
+          await driver.delayMs(500);
+        }
+        await cleanupToRoot(driver);
+      } catch (e) {
+        err('XlPassToPass afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    // PC 自由窗口 resize 后，笔记列表占比保持不变。非 PC 跳过。
+    it('should_note_window_can_change_size_on_pc_breakpoint', Level.LEVEL1, async (done: Function) => {
+      const device = await currentDeviceClass();
+      if (device !== 'pc') {
+        dbg('PC_自由窗口：当前非 PC 设备，跳过');
+        done();
+        return;
+      }
+      const TOL = 0.03; // ratio 允许漂移
+      const RECOVERY_MS = 800; // resize 后等待 UI 重排
+      try {
+        // resize 前 ratio
+        const list1 = await getBounds(driver, ON.id(Sid.NOTE_LIST), '笔记列表(resize 前)');
+        const win1 = await getWindowBounds(driver);
+        if (list1 === null || win1 === null) {
+          dbg('PC_自由窗口: 初始 ratio 读取失败，判失败');
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const win1W = win1.right - win1.left;
+        if (win1W === 0) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const ratio1 = (list1.right - list1.left) / win1W;
+        const h1 = win1.bottom - win1.top;
+
+        // 放大窗口：宽 ×1.4、高 ×1.3，拖右下角。先 moveTo(0,0) 防止贴屏幕右下边界。
+        await moveWindow(driver, 0, 0);
+        const ok = await resizeWindow(driver, Math.round(win1W * 1.4), Math.round(h1 * 1.3),
+          ResizeDirection.RIGHT_DOWN);
+        if (!ok) {
+          dbg('PC_自由窗口: resize 失败（可能命中系统窗口尺寸上限），判失败');
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        await driver.delayMs(RECOVERY_MS);
+
+        // resize 后 ratio
+        const list2 = await getBounds(driver, ON.id(Sid.NOTE_LIST), '笔记列表(resize 后)');
+        const win2 = await getWindowBounds(driver);
+        if (list2 === null || win2 === null) {
+          dbg('PC_自由窗口: resize 后 ratio 读取失败，判失败');
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const win2W = win2.right - win2.left;
+        if (win2W === 0) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const ratio2 = (list2.right - list2.left) / win2W;
+
+        const drift = Math.abs(ratio1 - ratio2);
+        dbg(`PC_自由窗口: ratio1=${ratio1} ratio2=${ratio2} drift=${drift}（容差${TOL}）`);
+        expect(drift <= TOL).assertTrue();
+      } catch (e) {
+        err('PC_自由窗口 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
