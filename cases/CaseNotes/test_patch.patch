+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  startAbility,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  assertListRatio,
+  dismissAppDialogs,
+  cleanupToRoot,
+  currentDeviceClass,
+} from './TestHelper';
+
+/**
+ * 套件：PC(2in1) 列表占比用例（有期望值的断言）。
+ * PC 窗口宽常落入 lg 断点，但为独立三栏布局，与平板场景不同，故从 LgFailToPass 拆出。
+ *   - 笔记列表宽 ≈ 窗口宽 × 30%（三栏布局中栏）
+ * 仅在 currentDeviceClass() === 'pc' 时执行，其余设备跳过。
+ * 注：resize 稳定性（占比无变化）用例性质不同，已拆至 XlPassToPass。
+ */
+export default function xlFailToPassTest() {
+  describe('XlFailToPass', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('XL_FAIL_TO_PASS');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'EntryAbility');
+        await driver.delayMs(1000);
+        await dismissAppDialogs(driver);
+      } catch (e) {
+        err('XlFailToPass beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('XL_FAIL_TO_PASS');
+        await cleanupToRoot(driver);
+      } catch (e) {
+        err('XlFailToPass afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    // 笔记列表（PC 2in1）：三栏中栏，列表宽/窗口宽 ∈ [0.25, 0.34]。非 PC 跳过。
+    it('should_note_list_be_side_bar_on_pc_breakpoint', Level.LEVEL1, async (done: Function) => {
+      const device = await currentDeviceClass();
+      if (device !== 'pc') {
+        dbg('PC_2in1：当前非 PC 设备，跳过');
+        done();
+        return;
+      }
+      try {
+        await assertListRatio(driver, 0.25, 0.34, 'PC_2in1');
+      } catch (e) {
+        err('PC_2in1 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
diff --git a/product/phone/src/ohosTest/ets/test/XlPassToPass.test.ets b/product/phone/src/ohosTest/ets/test/XlPassToPass.test.ets
