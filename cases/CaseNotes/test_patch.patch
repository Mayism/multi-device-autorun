+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  startAbility,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  assertListRatio,
+  assertItemRatio,
+  dismissAppDialogs,
+  cleanupToRoot,
+  currentBreakpoint,
+} from './TestHelper';
+
+/**
+ * 套件：MD 断点（折叠屏展开）一多适配用例。
+ *   - 笔记列表宽 ≥ 窗口宽 × 80%（全屏展示）
+ *   - 分类 ListItem 宽 ≈ 分类列表宽（单列，占比 ≈ 1）
+ * 仅在 currentBreakpoint() === 'md' 时执行，其余断点跳过。
+ */
+export default function mdPassToPassTest() {
+  describe('MdPassToPass', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('MD_PASS_TO_PASS');
+        driver = Driver.create();
+        const bundleName = getBundleName();
+        await startAbility(driver, bundleName, 'EntryAbility');
+        await driver.delayMs(1000);
+        await dismissAppDialogs(driver);
+      } catch (e) {
+        err('MdPassToPass beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('MD_PASS_TO_PASS');
+        await cleanupToRoot(driver);
+      } catch (e) {
+        err('MdPassToPass afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    // 笔记列表（MD）：列表宽/窗口宽 ∈ [0.80, 1.0]
+    it('should_note_list_be_full_screen_on_md_breakpoint', Level.LEVEL1, async (done: Function) => {
+      if (currentBreakpoint() !== 'md') {
+        dbg('MD_折叠屏：当前断点不符，跳过');
+        done();
+        return;
+      }
+      try {
+        await assertListRatio(driver, 0.80, 1.0, 'MD_折叠屏');
+      } catch (e) {
+        err('MD_折叠屏 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+
+    // 分类列表（MD）：ListItem 宽/列表宽 ≈ 1（单列）
+    it('should_category_list_be_one_lanes_on_md_breakpoint', Level.LEVEL1, async (done: Function) => {
+      if (currentBreakpoint() !== 'md') {
+        dbg('MD_折叠屏：当前断点不符，跳过');
+        done();
+        return;
+      }
+      try {
+        await assertItemRatio(driver, 1.0, 'MD_折叠屏');
+      } catch (e) {
+        err('MD_折叠屏 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
