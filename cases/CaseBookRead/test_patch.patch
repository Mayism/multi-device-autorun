+        const lanes = await countFirstRowItems(driver, ON.id(Sid.BOOK_SHELF_GRID_ITEM), grid, '书架列数');
+        dbg(`LG_平板: 书架首行列数=${lanes}（期望 =6）`);
+        expect(lanes === 6).assertTrue();
+      } catch (e) {
+        err('LG_平板 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      } finally {
+        await cleanupToRoot(driver);
