+}
+
+/**
+ * 进入阅读详情页（书城 tab → banner 单卡）。
+ *
+ * 注意：banner 是书城 List 的首个 ListItem，前置用例（如猜你喜欢）可能上滑导致 banner 滚出视口。
+ * 因此切到书城后先下滑回到顶部，再等待 banner 渲染并点击。
+ * 点击 banner 触发 BookSwiperCard.onImageClick → pushByLogin(READ_KIT_ROUTER)。
+ */
+export async function goToReadPage(driver: Driver): Promise<void> {
+  try {
+    await goToTab(driver, '书城');
+    // 若 banner 因前置滚动不在视口，先下滑回到书城顶部。
+    const win = await getWindowBounds(driver);
+    if (win !== null) {
+      const cx = Math.floor((win.left + win.right) / 2);
+      const topY = Math.floor(win.top + (win.bottom - win.top) * 0.30);
+      const bottomY = Math.floor(win.top + (win.bottom - win.top) * 0.70);
+      // 下滑最多 4 次回到顶部，每次后检测 banner 单卡是否出现。
+      for (let i = 0; i < 4; i++) {
+        const card = await getBounds(driver, ON.id(Sid.BOOK_BANNER_CARD), 'banner单卡');
+        if (card !== null) {
+          break;
+        }
+        await driver.swipe(cx, topY, cx, bottomY, 1500);
+        await driver.delayMs(500);
+      }
+    }
+    // 点击 banner 单卡进入阅读详情页。
+    await clickIfExists(driver, ON.id(Sid.BOOK_BANNER_CARD), 'banner单卡');
+    await driver.delayMs(1500);
+  } catch (e) {
+    dbg(`goToReadPage 异常: ${(e as Error).message}`);
+  }
+}
+
+// ============================ 状态恢复 ============================
+
+/**
+ * 回退到首页书城 tab 根态。
+ * pressBack 前先检测是否已在首页（tab 栏可见），避免在首页误触系统返回退出应用。
+ */
+export async function cleanupToRoot(driver: Driver): Promise<void> {
+  const MAX_BACK = 6;
+  try {
+    for (let i = 0; i < MAX_BACK; i++) {
+      const tabBar = await getBounds(driver, ON.id(Sid.HOME_TABBAR), '首页tab栏');
+      if (tabBar !== null) {
+        dbg(`cleanupToRoot: 第${i}次检测到首页，停止 pressBack`);
+        break;
+      }
+      await driver.pressBack();
+      await driver.delayMs(300);
+    }
+    // 回到首页后切到书城 tab，统一根态。
+    await clickTextIfExists(driver, '书城');
+    await driver.delayMs(300);
+    dbg('cleanupToRoot: 已回退到首页书城 tab');
+  } catch (e) {
+    err(`cleanupToRoot 异常: ${(e as Error).message}`);
+  }
+}
