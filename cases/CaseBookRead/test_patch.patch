+/**
+ * 进入关于页（我的 tab → 设置齿轮 → 设置页 → 关于入口）。
+ * 设置页内"关于"入口需点击，路径较长，带兜底。
+ */
+export async function goToAbout(driver: Driver): Promise<void> {
+  try {
+    await goToTab(driver, '我的');
+    // 头部齿轮图标 → 设置页。
+    await clickIfExists(driver, ON.id(Sid.MINE_SETTING_ENTRY), '设置齿轮');
+    await driver.delayMs(800);
+    // 设置页"关于"入口。
+    await clickByText(driver, '关于').catch(() => {});
+    await driver.delayMs(1000);
+  } catch (e) {
