+/*
+ * 一多适配 UI 测试公共辅助。
+ * 提供断点判定、窗口/组件查询、点击、日志、状态恢复等基础能力，并 re-export TestKit API。
+ * 锚点 id 与业务源码中 .id('xxx') 保持一致，详见各被测页面。
+ */
+import { Want } from '@kit.AbilityKit';
+import { abilityDelegatorRegistry, Driver, ON, On, Component, UiWindow } from '@kit.TestKit';
+import display from '@ohos.display';
+
+// ============================ 常量 ============================
+
+/** 被测应用 bundleName（接入时替换为真实包名，见 AppScope/app.json5）。 */
+export const BUNDLE_NAME = 'ydts.1.xxxxxx';
+
+/** 断点分界点（vp）：SM < 600 | MD 600–840 | LG ≥ 840。 */
+export const BP_SM_MAX = 600;
+export const BP_MD_MAX = 840;
+
+// ============================ 类型 ============================
+
+export type Breakpoint = 'sm' | 'md' | 'lg';
+
+/** UiTest Rect 的本地接口（SDK Rect 类型为 any）。 */
+export interface Bounds {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+/** 被测组件测试 ID。与业务源码中 .id('xxx') 一一对应。 */
+export enum Sid {
+  // 首页
+  HOME_TABBAR = 'home_tabbar',
+  // 书架
+  BOOK_SHELF_GRID = 'book_shelf_grid',
+  BOOK_SHELF_GRID_ITEM = 'book_shelf_grid_item',
+  // 书城 banner
+  BOOK_BANNER = 'book_banner',
+  BOOK_BANNER_CARD = 'book_banner_card',
+  // 今日力荐
+  RECOMMEND_GRID = 'recommend_grid',
+  RECOMMEND_GRID_ITEM = 'recommend_grid_item',
+  // 猜你喜欢
+  GUESS_LIKE_LIST = 'guess_like_list',
+  GUESS_LIKE_ITEM = 'guess_like_item',
+  // 阅读详情页
+  BOOK_INFO_CARD = 'book_info_card',
+  BOOK_DESC_CARD = 'book_desc_card',
+  // 分类页
+  CATEGORY_LIST = 'category_list',
+  CATEGORY_ITEM = 'category_item',
+  // 我的 tab
+  LOGIN_CARD = 'login_card',
+  ACCOUNT_CARD = 'account_card',
+  SERVICE_LIST = 'service_list',
+  SERVICE_ITEM = 'service_item',
+  MINE_SETTING_ENTRY = 'mine_setting_entry',
+  // 阅读偏好设置
+  PREFERENCE_CONTENT = 'preference_content',
+  PREFERENCE_CHANNEL_LIST = 'preference_channel_list',
+  PREFERENCE_CHANNEL_ITEM = 'preference_channel_item',
+  // 福利中心
+  SIGNIN_CARD = 'signin_card',
+  EARN_CARD = 'earn_card',
+  // 充值
+  RECHARGE_LIST = 'recharge_list',
+  RECHARGE_ITEM = 'recharge_item',
+  // 充值记录
+  RECHARGE_RECORD_CONTENT = 'recharge_record_content',
+  // 关于
+  ABOUT_CONTENT = 'about_content',
+}
+
+// ============================ 断点 ============================
+
+/** 读取屏幕宽度（vp），基于 display 的 densityPixels 换算。 */
+export function getWindowWidthVp(): number {
+  const d = display.getDefaultDisplaySync();
+  const density = d.densityPixels;
+  const px = d.width;
+  const vp = density > 0 ? px / density : px;
+  console.info(`[BR] getWindowWidthVp: ${px}px / density=${density} → ${vp}vp`);
+  return vp;
+}
+
+/** 由窗口宽判定断点。 */
+export function breakpointOf(widthVp: number): Breakpoint {
+  if (widthVp < BP_SM_MAX) {
+    return 'sm';
+  }
+  if (widthVp < BP_MD_MAX) {
+    return 'md';
+  }
+  return 'lg';
+}
+
+/** 各断点的页面左右边距（vp），用于 banner 卡片断言时扣除容器内边距。 */
+export function pagePaddingOf(bp: Breakpoint): number {
+  switch (bp) {
+    case 'sm': return 16;
+    case 'md': return 24;
+    case 'lg': return 32;
+    default: return 32;
+  }
+}
+
+/**
+ * 当前断点，在 it 内部调用（主窗口已就绪）。
+ * 基于显示屏宽换算 vp 判定，不依赖工程代码。
+ */
+export function currentBreakpoint(): Breakpoint {
+  try {
+    const bp = breakpointOf(getWindowWidthVp());
+    console.info(`[BR] currentBreakpoint = ${bp}`);
+    return bp;
+  } catch (e) {
+    console.error(`[BR] currentBreakpoint 读取失败，回退 'sm'：${(e as Error).message}`);
+    return 'sm';
+  }
+}
+
+// ============================ Delegator & 日志 ============================
+
+export const delegator: abilityDelegatorRegistry.AbilityDelegator =
+  abilityDelegatorRegistry.getAbilityDelegator();
+
+/** 取被测 bundleName，优先 delegator 参数，回退模块常量。 */
+export function getBundleName(): string {
+  try {
+    const bn = abilityDelegatorRegistry.getArguments().bundleName;
+    return bn || BUNDLE_NAME;
+  } catch (e) {
+    return BUNDLE_NAME;
+  }
+}
+
+let _caseTag: string = '';
+export function setCaseTag(tag: string): void {
+  _caseTag = tag;
+}
+
+export function dbg(msg: string): void {
+  const prefix = _caseTag ? `[BR][${_caseTag}]` : '[BR]';
+  console.info(`${prefix} ${msg}`);
+}
+
+export function err(msg: string): void {
+  const prefix = _caseTag ? `[BR][${_caseTag}]` : '[BR]';
+  console.error(`${prefix} ${msg}`);
+}
+
+// ============================ 启动 ============================
+
+/** 启动被测 ability 并等待 UI 稳定。 */
+export async function startAbility(driver: Driver, bundleName: string, abilityName: string): Promise<void> {
+  try {
+    const want: Want = {
+      bundleName: bundleName,
+      abilityName: abilityName,
+    };
+    await delegator.startAbility(want);
+    await driver.waitForIdle(3000, 5000);
+  } catch (e) {
+    err('startAbility 失败: ' + JSON.stringify(e));
+  }
+}
+
+// ============================ 窗口查询 ============================
+
+/** 通过 Driver 查找被测应用主窗口。 */
+export async function getUiWindow(driver: Driver): Promise<UiWindow | null> {
+  try {
+    const bn = getBundleName();
+    const win: UiWindow = await driver.findWindow({ bundleName: bn });
+    if (win === null || win === undefined) {
+      dbg(`getUiWindow: 被测窗口未找到（bundleName=${bn}）`);
+      return null;
+    }
+    return win;
+  } catch (e) {
+    dbg(`getUiWindow 异常: ${(e as Error).message}`);
+    return null;
+  }
+}
+
+/** 被测窗口屏幕绝对边界（px），与组件 getBounds() 同基准。 */
+export async function getWindowBounds(driver: Driver): Promise<Bounds | null> {
+  const uiWin = await getUiWindow(driver);
+  if (uiWin === null) {
+    dbg('getWindowBounds: 被测窗口未找到 → null');
+    return null;
+  }
+  try {
+    const b = await uiWin.getBounds() as Bounds;
+    const result: Bounds = { left: b.left, top: b.top, right: b.right, bottom: b.bottom };
+    dbg(`getWindowBounds: L=${result.left} T=${result.top} R=${result.right} B=${result.bottom} ` +
+      `(${result.right - result.left}x${result.bottom - result.top})`);
+    return result;
+  } catch (e) {
+    dbg(`getWindowBounds 异常: ${(e as Error).message} → null`);
+    return null;
+  }
+}
+
+// ============================ 组件查询 ============================
+
+/**
+ * 统计落在指定容器边界内的可见组件数量。
+ *
+ * 用于 banner 这类缩放 Swiper：卡片 id（book_banner_card）在每张卡片上重复，
+ * 单个 findComponent 只取首个，无法验证一屏实际渲染的卡片数。
+ * Swiper.displayCount(count) 决定一屏 item 数，故落在 banner 容器边界内的卡片数即 count。
+ *
+ * 判定"落在容器内"：组件 left ≥ 容器 left 且 right ≤ 容器 right（横向不溢出），
+ * 这样可同时剔除被 Swiper 裁剪到视口外的缓存 item 与缩放后超出边界的项。
+ *
+ * @param driver  Driver 实例
+ * @param on      组件匹配器（通常为 ON.id(...)）
+ * @param host    宿主容器边界（如 banner 容器）
+ * @param label   日志标签
+ * @returns 落在容器内的组件数量；查询异常返回 -1
+ */
+export async function countComponentsInBounds(driver: Driver, on: On, host: Bounds, label?: string): Promise<number> {
+  const tag = label ?? '组件';
+  try {
+    const comps: Component[] = await driver.findComponents(on);
+    let count = 0;
+    const inside: Bounds[] = [];
+    for (const comp of comps) {
+      const r = await comp.getBounds() as Bounds;
+      if (r.left >= host.left && r.right <= host.right) {
+        count++;
+        inside.push({ left: r.left, top: r.top, right: r.right, bottom: r.bottom });
+      }
+    }
+    dbg(`countComponentsInBounds[${tag}]: 命中=${comps.length} 容器内=${count} ` +
+      `(容器 L=${host.left} R=${host.right})`);
+    return count;
+  } catch (e) {
+    dbg(`countComponentsInBounds[${tag}]: 异常, err=${(e as Error).message}`);
+    return -1;
+  }
+}
+
+/**
+ * 统计容器内「首行」item 的数量，即一行的列数。
+ *
+ * 用于 lanes 纵向多列 List 或 Flex wrap 流式布局（如分类页、阅读偏好频道）：
+ * 这类布局没有横滑的"一屏可见数"概念，一多适配体现为每行容纳的列数。
+ * 取所有落在容器内 item 的 top，与首个 item 的 top 对齐（误差容忍 item 高度的一半）
+ * 即视为同一行，统计其数量得到列数。
+ *
+ * @param driver   Driver 实例
+ * @param on       item 匹配器（通常为 ON.id(...)）
+ * @param host     宿主容器边界
+ * @param label    日志标签
+ * @returns 首行 item 数量；查询异常或无 item 返回 -1
+ */
+export async function countFirstRowItems(driver: Driver, on: On, host: Bounds, label?: string): Promise<number> {
+  const tag = label ?? '首行';
+  try {
+    const comps: Component[] = await driver.findComponents(on);
+    if (comps.length === 0) {
+      dbg(`countFirstRowItems[${tag}]: 未找到 item`);
+      return -1;
+    }
+    // 收集落在容器内的 item 边界。
+    const rows: Bounds[] = [];
+    for (const comp of comps) {
+      const r = await comp.getBounds() as Bounds;
+      if (r.left >= host.left && r.right <= host.right) {
+        rows.push({ left: r.left, top: r.top, right: r.right, bottom: r.bottom });
+      }
+    }
+    if (rows.length === 0) {
+      dbg(`countFirstRowItems[${tag}]: 容器内无 item`);
+      return -1;
+    }
+    // 按水平位置排序，取最靠左的首个作为基准行。
+    rows.sort((a, b) => a.left - b.left);
+    const base = rows[0];
+    const itemH = base.bottom - base.top;
+    // top 在基准行 item 高度一半范围内视为同一行。
+    const tolerance = Math.max(itemH * 0.5, 2);
+    let count = 0;
+    for (const r of rows) {
+      if (Math.abs(r.top - base.top) <= tolerance) {
+        count++;
+      }
+    }
+    dbg(`countFirstRowItems[${tag}]: 容器内item=${rows.length} 首行列数=${count} ` +
+      `(baseTop=${base.top} itemH=${itemH})`);
+    return count;
+  } catch (e) {
+    dbg(`countFirstRowItems[${tag}]: 异常, err=${(e as Error).message}`);
+    return -1;
+  }
+}
+
+/** 组件边界，未找到返回 null。 */
+export async function getBounds(driver: Driver, on: On, label?: string): Promise<Bounds | null> {
+  const tag = label ?? '组件';
+  try {
+    const comp: Component = await driver.findComponent(on);
+    const r = await comp.getBounds() as Bounds;
+    const result: Bounds = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
+    dbg(`getBounds[${tag}]: L=${result.left} T=${result.top} R=${result.right} B=${result.bottom} ` +
+      `(${result.right - result.left}x${result.bottom - result.top})`);
+    return result;
+  } catch (e) {
+    dbg(`getBounds[${tag}]: 未找到/异常, err=${(e as Error).message}`);
+    return null;
+  }
+}
+
+/** 等待组件出现并返回边界，超时返回 null。 */
+export async function waitForBounds(driver: Driver, on: On, timeout: number, label?: string): Promise<Bounds | null> {
+  const tag = label ?? '组件';
+  try {
+    const comp: Component = await driver.waitForComponent(on, timeout);
+    const r = await comp.getBounds() as Bounds;
+    const result: Bounds = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
+    dbg(`waitForBounds[${tag}]: L=${result.left} T=${result.top} R=${result.right} B=${result.bottom} ` +
+      `(${result.right - result.left}x${result.bottom - result.top})`);
+    return result;
+  } catch (e) {
+    dbg(`waitForBounds[${tag}]: 等待超时/异常, err=${(e as Error).message}`);
+    return null;
+  }
+}
+
+/** 点击组件（若存在），返回是否成功。 */
+export async function clickIfExists(driver: Driver, on: On, label?: string): Promise<boolean> {
+  const tag = label ?? '组件';
+  try {
+    const comp: Component = await driver.findComponent(on);
+    await comp.click();
+    dbg(`clickIfExists[${tag}]: 点击成功`);
+    return true;
+  } catch (e) {
+    dbg(`clickIfExists[${tag}]: 未找到/点击失败, err=${(e as Error).message}`);
+    return false;
+  }
+}
+
+/** 按文本查找并点击组件，未找到抛 Error。 */
+export async function clickByText(driver: Driver, text: string): Promise<void> {
+  try {
+    const comp: Component = await driver.findComponent(ON.text(text));
+    await comp.click();
+    dbg(`clickByText: 点击成功 text='${text}'`);
+  } catch (e) {
+    dbg(`clickByText: 点击失败/未找到 text='${text}', err=${(e as Error).message}`);
+    throw new Error(`clickByText failed: text='${text}', cause=${(e as Error).message}`);
+  }
+}
+
+/** 按文本查找并点击，未找到返回 false（不抛错）。 */
+export async function clickTextIfExists(driver: Driver, text: string): Promise<boolean> {
+  try {
+    const comp: Component = await driver.findComponent(ON.text(text));
+    await comp.click();
+    dbg(`clickTextIfExists: 点击成功 text='${text}'`);
+    return true;
+  } catch (e) {
+    dbg(`clickTextIfExists: 未找到 text='${text}', err=${(e as Error).message}`);
+    return false;
+  }
+}
+
+// ============================ 登录态 ============================
+
+/** 测试用登录态对象结构（对齐业务 UserInfo 关键字段，供 AppStorage 注入）。 */
+interface UserInfoMock {
+  id: string;
+  nickName: string;
+  avatarUrl: string;
+  telephone: string;
+  isLogin: boolean;
+  isMembership: boolean;
+  bookCoins: number;
+  totalReading: number;
+  totalListening: number;
+  level: number;
+  continuousBuy: boolean;
+  reminderTime: number;
+  fullScreen: boolean;
+  noTimeBattery: boolean;
+}
+
+/**
+ * 注入已登录的用户态，供需要登录的二级页面用例使用。
+ *
+ * 登录态判定链路（已全量覆盖）：
+ * 1) TCRouter.pushByLogin：仅检查 AppStorage('userInfo') !== undefined → 注入后放行；
+ * 2) 各页面 aboutToAppear/onPageShow：重新从 AppStorage.get('userInfo') 读取并同步到
+ *    UserInfoModel（如 MyInfoCard.loadUserInfo），isLogin 字段为 true 即显示已登录态；
+ * 3) 业务无页面直接读 AppStorage('membershipStatus')/('bookCoins')（仅 LoginPage 写入时读取），
+ *    故无需单独注入派生 key。
+ *
+ * 数据结构对齐业务 LoginPage.mockUserLogin()，保证与真实登录完全一致。
+ * 各套件 beforeAll 的 startAbility 之后、passLaunchAndReachHome 之前调用。
+ */
+export function injectLoggedIn(): void {
+  try {
+    const mock: UserInfoMock = {
+      id: '1234',
+      nickName: '测试用户',
+      avatarUrl: '',
+      telephone: '13800000000',
+      isLogin: true,
+      isMembership: false,
+      bookCoins: 100,
+      totalReading: 50,
+      totalListening: 15,
+      level: 1,
+      continuousBuy: false,
+      reminderTime: 0,
+      fullScreen: false,
+      noTimeBattery: false
+    };
+    AppStorage.setOrCreate<Object>('userInfo', mock);
+    dbg(`injectLoggedIn: 已注入登录态 (id=${mock.id}, nickName=${mock.nickName}, ` +
+      `isLogin=${mock.isLogin}, bookCoins=${mock.bookCoins}, level=${mock.level})`);
+  } catch (e) {
+    err('injectLoggedIn 失败: ' + (e as Error).message);
+  }
+}
+
+// ============================ 启动后处理 ============================
+
+/**
+ * 处理启动链路：隐私协议页（bindSheet "同意"）→ 开屏广告页 → 首页。
+ * 在 beforeAll 启动应用后调用，确保到达首页书城 tab。
+ * 各步骤均带兜底，失败不阻断（后续用例会自行检测目标页是否就绪）。
+ */
+export async function passLaunchAndReachHome(driver: Driver): Promise<void> {
+  try {
+    // 1. 隐私协议页：点击"同意"（bindSheet 内文本按钮）。
+    await driver.delayMs(1500);
+    const agreed = await clickTextIfExists(driver, '同意');
+    if (agreed) {
+      dbg('passLaunchAndReachHome: 已点击隐私页"同意"');
+    }
+    // 2. 开屏广告页：等待其自动关闭（网络加载可能超时），最多等 8s。
+    await driver.delayMs(2000);
+    // 3. 到达首页后切到"书城"tab。
+    await clickByText(driver, '书城').catch(() => {
+      dbg('passLaunchAndReachHome: 切换书城 tab 未成功，可能已在首页');
+    });
+    await driver.delayMs(800);
+  } catch (e) {
+    err('passLaunchAndReachHome 异常: ' + (e as Error).message);
+  }
+}
+
+// ============================ 导航 ============================
+
+/** 切换到首页指定 tab（书架/书城/分类/我的）。 */
+export async function goToTab(driver: Driver, tabText: string): Promise<void> {
+  try {
+    await clickByText(driver, tabText);
+    await driver.delayMs(800);
+    dbg(`goToTab: 切换到 ${tabText}`);
+  } catch (e) {
+    dbg(`goToTab: 切换 ${tabText} 失败, err=${(e as Error).message}`);
+  }
+}
+
+/**
+ * 在书城 tab 内上滑，让"猜你喜欢"（位于今日力荐下方，需滚动才进入视口）可见。
+ * 通过 swipe 从屏幕下半部向上半部滑动触发列表滚动。
+ */
+export async function scrollGuessLikeIntoView(driver: Driver): Promise<void> {
+  try {
+    const win = await getWindowBounds(driver);
+    if (win === null) {
+      dbg('scrollGuessLikeIntoView: 窗口边界为空，跳过');
+      return;
+    }
+    const cx = Math.floor((win.left + win.right) / 2);
+    const startY = Math.floor(win.top + (win.bottom - win.top) * 0.75);
+    const endY = Math.floor(win.top + (win.bottom - win.top) * 0.40);
+    // 连续上滑若干次，每次后检测猜你喜欢是否出现。
+    for (let i = 0; i < 4; i++) {
+      const found = await getBounds(driver, ON.id(Sid.GUESS_LIKE_LIST), '猜你喜欢list');
+      if (found !== null) {
+        dbg(`scrollGuessLikeIntoView: 第${i}次检测到猜你喜欢，停止滑动`);
+        return;
+      }
+      await driver.swipe(cx, startY, cx, endY, 1500);
+      await driver.delayMs(500);
+    }
+    dbg('scrollGuessLikeIntoView: 滑动结束（猜你喜欢可能仍未渲染）');
+  } catch (e) {
+    dbg(`scrollGuessLikeIntoView 异常: ${(e as Error).message}`);
+  }
+}
