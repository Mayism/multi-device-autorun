@@ -0,0 +1,26 @@
+import { abilityDelegatorRegistry, TestRunner } from '@kit.TestKit';
+import { Hypium } from '@ohos/hypium';
+
+const CASE_TIMEOUT_MS: number = 330000;
+
+export default class OpenHarmonyTestRunner implements TestRunner {
+  onPrepare(): void {
+    console.info('[CREDIT_UITEST] 准备信用卡页面 UITest。');
+  }
+
+  async onRun(): Promise<void> {
+    const delegator = abilityDelegatorRegistry.getAbilityDelegator();
+    const args = abilityDelegatorRegistry.getArguments();
+    // UITest 导入时就尝试获取 AbilityDelegator 并启动 daemon。运行器顶层不能静态导入
+    // 依赖 Driver/ON 的测试模块，否则可能在 delegator 注册前把 UITest 初始化到错误的连接。
+    const suite = await import('../test/List.test');
+    // Hypium 1.0.25 的默认超时只有 5 秒，且 it() 不支持第四个 timeout 参数。
+    // 必须在 hypiumTest 读取参数之前设置；保留调用者指定的更长超时。
+    const supplied = Number(args.parameters['-s timeout'] ?? args.parameters['timeout'] ?? '0');
+    const timeout = Number.isFinite(supplied) ? Math.max(supplied, CASE_TIMEOUT_MS) : CASE_TIMEOUT_MS;
+    args.parameters['-s timeout'] = timeout.toString();
+    args.parameters['timeout'] = timeout.toString();
+    console.info(`[CREDIT_UITEST] 每条用例超时 ${timeout} ms。`);
+    Hypium.hypiumTest(delegator, args, suite.default);
+  }
+}
diff --git a/base/entry/src/ohosTest/ets/utils/CreditFoldHelper.ets b/base/entry/src/ohosTest/ets/utils/CreditFoldHelper.ets
new file mode 100644
index 0000000..f61541d
--- /dev/null
+++ b/base/entry/src/ohosTest/ets/utils/CreditFoldHelper.ets
@@ -0,0 +1,110 @@
+import { Component, Driver, MatchPattern, ON, Rect } from '@kit.TestKit';
+import { BusinessError } from '@kit.BasicServicesKit';
+import http from '@ohos.net.http';
+
+const CONTROL_URL: string = 'http://127.0.0.1:8765';
+const MAX_SCROLLS: number = 6;
+
+export interface CreditLayout {
+  web: Rect;
+  minimum?: Rect;
+  repay?: Rect;
+}
+
+interface FoldResponse {
+  success: boolean;
+  message?: string;
+}
+
+export async function foldScreen(state: 'open' | 'close'): Promise<void> {
+  const client = http.createHttp();
+  try {
+    const response = await client.request(`${CONTROL_URL}/fold?state=${state}`, {
+      method: http.RequestMethod.GET, connectTimeout: 2000, readTimeout: 12000
+    });
+    const result = JSON.parse(response.result as string) as FoldResponse;
+    if (response.responseCode !== 200 || result.success !== true) {
+      throw new Error(`折叠命令 ${state} 失败：${result.message ?? response.responseCode}`);
+    }
+    console.info(`[CREDIT_FOLD] 屏幕命令：${state}`);
+  } finally {
+    client.destroy();
+  }
+}
+
+export async function findButton(driver: Driver, text: string): Promise<Component | undefined> {
+  // ArkWeb 会把图标字符并入按钮名称，例如“图标 + 信用卡”，不能只做文字全等匹配。
+  let found = await driver.findComponents(ON.text(text, MatchPattern.CONTAINS).clickable(true).within(ON.type('Web')));
+  if (!found || found.length === 0) {
+    found = await driver.findComponents(ON.description(text).clickable(true).within(ON.type('Web')));
+  }
+  if (found && found.length > 1) {
+    throw new Error(`“${text}”匹配了多个可点击节点。`);
+  }
+  return found && found.length === 1 ? found[0] : undefined;
+}
+
+async function webBounds(driver: Driver): Promise<Rect> {
+  const web = await driver.findComponent(ON.type('Web'));
+  if (!web) {
+    throw new Error('未找到 Web，请检查 APP 和页面地址。');
+  }
+  return await web.getBounds();
+}
+
+async function swipe(driver: Driver, web: Rect, towardTop: boolean): Promise<void> {
+  const x = Math.round(web.left + (web.right - web.left) * 0.45);
+  const high = Math.round(web.top + (web.bottom - web.top) * 0.22);
+  const low = Math.round(web.top + (web.bottom - web.top) * 0.82);
+  await driver.swipeBetween({ x: x, y: towardTop ? high : low, displayId: web.displayId },
+    { x: x, y: towardTop ? low : high, displayId: web.displayId }, 1600);
+  await driver.delayMs(300);
+}
+
+async function visibleButton(driver: Driver, text: string, web: Rect): Promise<Rect | undefined> {
+  const button = await findButton(driver, text);
+  if (!button) {
+    return undefined;
+  }
+  try {
+    const rect = await button.getBounds();
+    // 先找到纵向完整的样本。横向越界保留给主用例判断，不能横向滚动“找回”按钮。
+    return rect.top >= web.top + 8 && rect.bottom <= web.bottom - 8 && rect.bottom > rect.top ?
+      rect : undefined;
+  } catch (error) {
+    if ((error as BusinessError).code === 17000004) { // 节点不在当前可见区域。
+      return undefined;
+    }
+    throw error as Error;
+  }
+}
+
+export async function clickText(driver: Driver, text: string): Promise<void> {
+  const web = await webBounds(driver);
+  const rect = await visibleButton(driver, text, web);
+  if (!rect || rect.right <= rect.left || rect.left < web.left || rect.right > web.right) {
+    throw new Error(`当前可见页面中找不到“${text}”按钮，请检查页面和 UITest 节点。`);
+  }
+  await driver.clickAt({ x: Math.round((rect.left + rect.right) / 2),
+    y: Math.round((rect.top + rect.bottom) / 2), displayId: web.displayId });
+}
+
+export async function readLayout(driver: Driver, stage: string): Promise<CreditLayout> {
+  const web = await webBounds(driver);
+  for (let step = 0; step < MAX_SCROLLS; step++) {
+    await swipe(driver, web, true);
+  }
+  const layout: CreditLayout = { web: web };
+  for (let step = 0; step <= MAX_SCROLLS; step++) {
+    layout.minimum = await visibleButton(driver, '最低还款', web) ?? layout.minimum;
+    layout.repay = await visibleButton(driver, '立即还款', web) ?? layout.repay;
+    if (layout.minimum && layout.repay) {
+      break;
+    }
+    if (step < MAX_SCROLLS) {
+      await swipe(driver, web, false);
+    }
+  }
+  console.info(`[CREDIT_FOLD] ${stage}：${JSON.stringify(layout)}`);
+  return layout;
+}
