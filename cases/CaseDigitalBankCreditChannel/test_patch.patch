@@ -0,0 +1,47 @@
+import { describe, it } from '@ohos/hypium';
+import { Driver } from '@kit.TestKit';
+import { TestHelper } from '../utils/TestHelper';
+import { clickText, findButton, foldScreen } from '../utils/CreditFoldHelper';
+
+const PAGE_WAIT_MS: number = 3000;
+const FOLD_OBSERVE_MS: number = 5000;
+
+export default function creditCardFoldableTest(): void {
+  describe('CreditCardFoldableTest', () => {
+    it('credit_foldable_smoke', 0, async () => {
+      const driver: Driver = Driver.create();
+      if (!driver) {
+        throw new Error('Driver.create() 返回空值，请通过 ohosTest 运行本用例。');
+      }
+
+      await TestHelper.prepareAbility(driver);
+      await foldScreen('open');
+      await driver.delayMs(PAGE_WAIT_MS);
+      if (await findButton(driver, '安全登录')) {
+        await clickText(driver, '安全登录');
+        await driver.delayMs(PAGE_WAIT_MS);
+      }
+      if (await findButton(driver, '返回')) {
+        await clickText(driver, '返回');
+        await driver.delayMs(PAGE_WAIT_MS);
+      }
+      if (!await findButton(driver, '信用卡')) {
+        throw new Error('尚未到达数字银行首页：未找到信用卡入口，请检查登录结果。');
+      }
+
+      await clickText(driver, '信用卡');
+      await driver.delayMs(PAGE_WAIT_MS);
+      console.info('[CREDIT_FOLDABLE] 已点击信用卡入口，开始折叠服务检查。');
+      try {
+        // 保留观察时间，不采集布局、不添加折叠效果断言。
+        await foldScreen('close');
+        console.info('[CREDIT_FOLDABLE] 折叠命令成功，等待人工观察。');
+        await driver.delayMs(FOLD_OBSERVE_MS);
+      } finally {
+        await foldScreen('open');
+        console.info('[CREDIT_FOLDABLE] 展开命令成功，等待人工观察。');
+        await driver.delayMs(FOLD_OBSERVE_MS);
+      }
+    });
+  });
+}
