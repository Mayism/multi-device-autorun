new file mode 100644
index 0000000..57e54ad
--- /dev/null
+++ b/base/entry/src/ohosTest/ets/test/CreditCardFold.test.ets
@@ -0,0 +1,109 @@
+import { describe, expect, it } from '@ohos/hypium';
+import { Driver, Rect } from '@kit.TestKit';
+import { TestHelper } from '../utils/TestHelper';
+import { clickText, findButton, foldScreen, readLayout } from '../utils/CreditFoldHelper';
+import { PhysicalOrientation, PhysicalRotationHelper } from '../utils/PhysicalRotationHelper';
+
+const PAGE_WAIT_MS: number = 3000;
+
+function width(rect: Rect | undefined): number {
+  return rect ? rect.right - rect.left : 0;
+}
+
+function inside(rect: Rect | undefined, web: Rect): boolean {
+  // 保留左右边距，避免把“裁剪后变窄的矩形”当作适配后的完整按钮。
+  return rect !== undefined && width(rect) > 0 && rect.bottom > rect.top &&
+    rect.left >= web.left + 8 && rect.right <= web.right - 8 &&
+    rect.top >= web.top && rect.bottom <= web.bottom;
+}
+
+function sameSizeAndX(before: Rect | undefined, after: Rect | undefined): boolean {
+  // 页面采集时可能发生纵向滚动，因此比较宽、高和 X，不比较按钮的绝对 Y。
+  return before !== undefined && after !== undefined &&
+    Math.abs(width(before) - width(after)) <= 6 &&
+    Math.abs((before.bottom - before.top) - (after.bottom - after.top)) <= 6 &&
+    Math.abs(before.left - after.left) <= 6;
+}
+
+export default function creditCardFoldTest(): void {
+  describe('CreditCardFoldTest', () => {
+    it('credit_fold_round_trip', 0, async () => {
+      const driver: Driver = Driver.create();
+      if (!driver) {
+        throw new Error('Driver.create() 返回空值，请通过 ohosTest 运行本用例。');
+      }
+
+      // 1. 打开 APP。
+      await TestHelper.prepareAbility(driver);
+
+      // 2. 解除屏幕旋转锁定。
+      await driver.setDisplayRotationEnabled(true);
+
+      // 3. 展开折叠屏。
+      await foldScreen('open');
+      await driver.delayMs(PAGE_WAIT_MS);
+
+      // 4. 准备正向竖屏；旋转只用于初始化。
+      await PhysicalRotationHelper.getInstance().rotateTo(PhysicalOrientation.ROTATION_180, 15000);
+      await driver.delayMs(PAGE_WAIT_MS);
+
+      // 5. 点击登录。演示账号已预填；已有会话时跳过登录。
+      if (await findButton(driver, '安全登录')) {
+        await clickText(driver, '安全登录');
+        await driver.delayMs(PAGE_WAIT_MS);
+      }
+      // 上一次演示若停留在信用卡页，先回首页；后续开合过程中不再退出页面。
+      if (await findButton(driver, '返回')) {
+        await clickText(driver, '返回');
+        await driver.delayMs(PAGE_WAIT_MS);
+      }
+      if (!await findButton(driver, '信用卡')) {
+        throw new Error('尚未到达数字银行首页：未找到信用卡入口，请检查登录结果。');
+      }
+
+      // 6. 进入信用卡页，记录展开布局 A。
+      await clickText(driver, '信用卡');
+      await driver.delayMs(PAGE_WAIT_MS);
+      const initial = await readLayout(driver, 'A 初始展开');
+      expect(inside(initial.minimum, initial.web) && inside(initial.repay, initial.web))
+        .message(`初始展开时，两颗还款按钮应完整显示。布局=${JSON.stringify(initial)}`).assertTrue();
+
+      let foldChanged = false;
+      let foldFits = false;
+      let foldShrinks = false;
+      let foldedDetails = '';
+      try {
+        // 7. 折叠，记录布局 B。
+        await foldScreen('close');
+        await driver.delayMs(PAGE_WAIT_MS);
+        const folded = await readLayout(driver, 'B 折叠');
+        foldedDetails = `Web=${JSON.stringify(folded.web)}；` +
+          `最低还款=${folded.minimum ? JSON.stringify(folded.minimum) : '未采到'}；` +
+          `立即还款=${folded.repay ? JSON.stringify(folded.repay) : '未采到'}`;
+
+        // 8. 先记录检查结果，保证布局不通过时也能继续第 9 步。
+        foldChanged = width(folded.web) < width(initial.web) * 0.9;
+        foldFits = inside(folded.minimum, folded.web) && inside(folded.repay, folded.web);
+        foldShrinks = width(folded.minimum) > 0 && width(folded.repay) > 0 &&
+          width(folded.minimum) < width(initial.minimum) * 0.95 &&
+          width(folded.repay) < width(initial.repay) * 0.95;
+      } finally {
+        // 9. 再展开，随后与初始布局 A 比较。
+        await foldScreen('open');
+        await driver.delayMs(PAGE_WAIT_MS);
+      }
+      const restored = await readLayout(driver, 'A′ 再展开');
+      const recovered = sameSizeAndX(initial.web, restored.web) &&
+        inside(restored.minimum, restored.web) && inside(restored.repay, restored.web) &&
+        sameSizeAndX(initial.minimum, restored.minimum) && sameSizeAndX(initial.repay, restored.repay);
+
+      const checks = `视口变窄=${foldChanged}, 完整显示=${foldFits}, ` +
+        `按钮缩小=${foldShrinks}, 展开恢复=${recovered}`;
+      console.info(`[CREDIT_FOLD] ${checks}`);
+      expect(foldChanged).message(`折叠后 Web 宽度应缩小至少 10%。${checks}`).assertTrue();
+      expect(foldFits).message(`折叠后两颗还款按钮应完整显示，左右留出至少 8px。${foldedDetails}；${checks}`).assertTrue();
+      expect(foldShrinks).message(`折叠后两颗还款按钮的宽度应各缩小超过 5%。${checks}`).assertTrue();
+      expect(recovered).message(`再展开后布局应恢复。${checks}`).assertTrue();
+    });
+  });
+}
