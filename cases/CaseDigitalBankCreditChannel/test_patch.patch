new file mode 100644
index 0000000..20324c8
--- /dev/null
+++ b/base/entry/src/ohosTest/ets/utils/NormalizedError.ets
@@ -0,0 +1,56 @@
+import { Logger } from './Logger';
+
+export class NormalizedError extends Error {
+
+  public code?: number;
+
+  public data?: ESObject;
+
+  public static from(cause: ESObject): NormalizedError {
+    if (cause === null || cause === undefined) {
+      return new NormalizedError();
+    }
+    if (typeof cause === 'object') {
+      let msg: string | undefined = undefined;
+      let code: number | undefined = undefined;
+      let data: ESObject = cause.data;
+      if (typeof cause.message === 'string') {
+        msg = cause.message;
+      }
+      if (typeof cause.code === 'number') {
+        code = cause.code;
+      }
+      const err: NormalizedError = new NormalizedError(msg, code, data);
+      if (typeof cause.stack === 'string') {
+        err.stack = cause.stack;
+      }
+      if (typeof cause.name === 'string') {
+        err.name = cause.name;
+      }
+      return err;
+    }
+    return new NormalizedError(String(cause));
+  }
+
+  public static logAndThrow(cause: ESObject): never {
+    const err: NormalizedError = NormalizedError.from(cause);
+    Logger.error(err.toLogLine());
+    throw err;
+  }
+
+  public toLogLine(): string {
+    const name: string = this.name ?? NormalizedError.name;
+    if (this.code || this.code === 0) {
+      return `${name}: code=${this.code} msg=${this.message}`;
+    } else {
+      return `${name}: ${this.message}`;
+    }
+  }
+
+  constructor(message?: string, code?: number, data?: ESObject) {
+    super(message);
+    this.code = code;
+    this.data = data;
+    this.name = NormalizedError.name;
+  }
+}
diff --git a/base/entry/src/ohosTest/ets/utils/PhysicalRotationHelper.ets b/base/entry/src/ohosTest/ets/utils/PhysicalRotationHelper.ets
new file mode 100644
index 0000000..f4af6d6
--- /dev/null
+++ b/base/entry/src/ohosTest/ets/utils/PhysicalRotationHelper.ets
@@ -0,0 +1,370 @@
+import http from '@ohos.net.http';
+import { sensor } from '@kit.SensorServiceKit';
+import { NormalizedError } from './NormalizedError';
+
+/**
+ * 设备相对于自身自然方向的物理旋转方向。
+ *
+ * 该值描述的是设备自身的物理姿态，与 Window / Display 最终是否旋转无关。
+ */
+export enum PhysicalOrientation {
+  UNKNOWN = -1,
+  /**
+   * 竖屏，自然方向。
+   *
+   * Pura 90 6.1.1(24) Emulator 实测：
+   * x ≈ 0
+   * y ≈ +9.8
+   */
+  ROTATION_0 = 0,
+  /**
+   * 横屏，从自然方向向右旋转一次。
+   *
+   * Pura 90 6.1.1(24) Emulator 实测：
+   * x ≈ -9.8
+   * y ≈ 0
+   */
+  ROTATION_90 = 90,
+  /**
+   * 反向竖屏，从自然方向旋转 180°。
+   *
+   * Pura 90 6.1.1(24) Emulator 实测：
+   * x ≈ 0
+   * y ≈ -9.8
+   */
+  ROTATION_180 = 180,
+  /**
+   * 反向横屏，从自然方向向左旋转一次。
+   *
+   * Pura 90 6.1.1(24) Emulator 实测：
+   * x ≈ +9.8
+   * y ≈ 0
+   */
+  ROTATION_270 = 270
+}
+
+type PhysicalRotationDirection = 'left' | 'right';
+
+interface FoldServerResponse {
+  success?: boolean;
+  message?: string;
+}
+
+const SENSOR_INTERVAL_NS: number = 50_000_000;
+const POLL_INTERVAL_MS: number = 20;
+const DEFAULT_TIMEOUT_MS: number = 3000;
+
+const MIN_PLANE_GRAVITY: number = 5.0;
+const MAX_CARDINAL_DEVIATION_DEG: number = 30;
+
+const FOLD_SERVER_HOST: string = '127.0.0.1';
+const FOLD_SERVER_PORT_START: number = 8765;
+const FOLD_SERVER_PORT_END: number = 8772;
+const PORT_CONNECT_TIMEOUT_MS: number = 500;
+const PORT_READ_TIMEOUT_MS: number = 1000;
+
+function delayExecutor(resolve: () => void): void {
+  setTimeout(resolve, POLL_INTERVAL_MS);
+}
+
+function delay(): Promise<void> {
+  return new Promise<void>(delayExecutor);
+}
+
+export class PhysicalRotationHelper {
+
+  private static instance: PhysicalRotationHelper | null = null;
+
+  private latestOrientation: PhysicalOrientation = PhysicalOrientation.UNKNOWN;
+
+  /**
+   * 已发现的 fold-server 端口。
+   * 首次调用时扫描 8765~8772，成功后复用。
+   */
+  private foldServerPort: number | null = null;
+
+  /**
+   * 防止多个 rotateTo() 同时向 Emulator 发旋转命令。
+   */
+  private rotating: boolean = false;
+
+  private constructor() {
+    try {
+      sensor.on(sensor.SensorId.GRAVITY, this.onGravity, { interval: SENSOR_INTERVAL_NS });
+    } catch (e) {
+      NormalizedError.logAndThrow(e);
+    }
+  }
+
+  public static getInstance(): PhysicalRotationHelper {
+    if (PhysicalRotationHelper.instance === null) {
+      PhysicalRotationHelper.instance = new PhysicalRotationHelper();
+    }
+    return PhysicalRotationHelper.instance;
+  }
+
+  /**
+   * 获取当前设备物理方向。
+   */
+  public async getPhysicalOrientation(timeoutMs: number = DEFAULT_TIMEOUT_MS): Promise<PhysicalOrientation> {
+    const deadline: number = Date.now() + timeoutMs;
+    while (Date.now() <= deadline) {
+      if (this.latestOrientation !== PhysicalOrientation.UNKNOWN) {
+        return this.latestOrientation;
+      }
+      await delay();
+    }
+    throw new Error(`Failed to determine physical orientation within ${timeoutMs}ms.`);
+  }
+
+  /**
+   * 将设备物理旋转至指定方向。
+   *
+   * 该方法只有在 GRAVITY 确认设备已经到达 target 后才返回。
+   * 如果在 timeout 内无法到达，则直接抛异常。
+   *
+   * 多个 rotateTo() 并发调用时会被串行处理。
+   */
+  public async rotateTo(
+    target: PhysicalOrientation,
+    timeoutMs: number = DEFAULT_TIMEOUT_MS
+  ): Promise<void> {
+    if (target === PhysicalOrientation.UNKNOWN) {
+      throw new Error('Cannot rotate to UNKNOWN.');
+    }
+    const deadline: number = Date.now() + timeoutMs;
+    await this.acquireRotationLock(deadline);
+    try {
+      await this.rotateToInternal(target, deadline);
+    } finally {
+      this.rotating = false;
+    }
+  }
+
+  /**
+   * 实际执行旋转。
+   */
+  private async rotateToInternal(target: PhysicalOrientation, deadline: number): Promise<void> {
+    let current: PhysicalOrientation = await this.waitForKnownOrientation(deadline);
+    if (current === target) {
+      return;
+    }
+    const delta: number = (target - current + 360) % 360;
+    switch (delta) {
+      case 90:
+        await this.rotateOneStep('right', target, deadline);
+        break;
+      case 180:
+        current = this.getRightOrientation(current);
+        await this.rotateOneStep('right', current, deadline);
+        await this.rotateOneStep('right', target, deadline);
+        break;
+      case 270:
+        await this.rotateOneStep('left', target, deadline);
+        break;
+      default:
+        throw new Error(`Invalid rotation delta: ${delta}`);
+    }
+    if (this.latestOrientation !== target) {
+      throw new Error('Physical orientation did not reach target.');
+    }
+  }
+
+  /**
+   * 执行单次 90° physical rotation。
+   *
+   * HTTP 返回成功不代表旋转完成，必须继续等待 GRAVITY 到达 expected。
+   */
+  private async rotateOneStep(
+    direction: PhysicalRotationDirection,
+    expected: PhysicalOrientation,
+    deadline: number
+  ): Promise<void> {
+    this.ensureNotTimeout(deadline);
+    await this.executePhysicalRotation(direction, deadline);
+    await this.waitForOrientation(expected, deadline);
+  }
+
+  /**
+   * 向 fold-server 发送物理旋转指令。
+   *
+   * 首次调用扫描 8765~8772，找到后缓存端口。
+   * HTTP 200 且响应 success=true 才认为指令发送成功。
+   */
+  private async executePhysicalRotation(direction: PhysicalRotationDirection, deadline: number): Promise<void> {
+    const cachedPort: number | null = this.foldServerPort;
+    if (cachedPort !== null) {
+      if (await this.tryExecutePhysicalRotation(cachedPort, direction, deadline)) {
+        return;
+      }
+      this.foldServerPort = null;
+    }
+    for (let port: number = FOLD_SERVER_PORT_START; port <= FOLD_SERVER_PORT_END; port++) {
+      if (port === cachedPort) {
+        continue;
+      }
+      this.ensureNotTimeout(deadline);
+      if (await this.tryExecutePhysicalRotation(port, direction, deadline)) {
+        this.foldServerPort = port;
+        return;
+      }
+    }
+    throw new Error(`Cannot find fold-server on ports ${FOLD_SERVER_PORT_START}-${FOLD_SERVER_PORT_END}.`);
+  }
+
+  /**
+   * 尝试在指定端口执行一次 rotation。
+   *
+   * 返回 false：该端口不是可用的 fold-server，调用方可继续探测其它端口。
+   * 已确认是 fold-server 但 command 执行失败：直接抛异常，不继续换端口。
+   */
+  private async tryExecutePhysicalRotation(port: number, direction: PhysicalRotationDirection, deadline: number): Promise<boolean> {
+    const remainingMs: number = deadline - Date.now();
+    if (remainingMs <= 0) {
+      throw new Error('Physical rotation timeout.');
+    }
+    const httpRequest: http.HttpRequest = http.createHttp();
+    const url: string = `http://${FOLD_SERVER_HOST}:${port}/rotation?direction=${direction}`;
+    let foldServerMatched: boolean = false;
+    try {
+      const response: http.HttpResponse = await httpRequest.request(url, {
+        method: http.RequestMethod.GET,
+        connectTimeout: Math.min(PORT_CONNECT_TIMEOUT_MS, remainingMs),
+        readTimeout: Math.min(PORT_READ_TIMEOUT_MS, remainingMs)
+      });
+      if (response.responseCode !== 200) {
+        return false;
+      }
+      let body: FoldServerResponse;
+      try {
+        body = JSON.parse(response.result as string) as FoldServerResponse;
+      } catch {
+        return false;
+      }
+      if (typeof body.success !== 'boolean') {
+        return false;
+      }
+      foldServerMatched = true;
+      if (!body.success) {
+        throw new Error(`Physical rotation command failed: ${body.message ?? 'unknown error'}`);
+      }
+      return true;
+    } catch (e) {
+      if (foldServerMatched) {
+        NormalizedError.logAndThrow(e);
+      }
+      return false;
+    } finally {
+      try {
+        httpRequest.destroy();
+      } catch {
+      }
+    }
+  }
+
+  /**
+   * 等待 GRAVITY 到达明确的目标物理方向。
+   */
+  private async waitForOrientation(target: PhysicalOrientation, deadline: number): Promise<void> {
+    while (Date.now() <= deadline) {
+      if (this.latestOrientation === target) {
+        return;
+      }
+      await delay();
+    }
+    throw new Error(`Physical rotation timeout. target=${target}, actual=${this.latestOrientation}`);
+  }
+
+  private async waitForKnownOrientation(deadline: number): Promise<PhysicalOrientation> {
+    while (Date.now() <= deadline) {
+      if (this.latestOrientation !== PhysicalOrientation.UNKNOWN) {
+        return this.latestOrientation;
+      }
+      await delay();
+    }
+    throw new Error('Failed to determine current physical orientation.');
+  }
+
+  /**
+   * rotateTo() 串行化。
+   */
+  private async acquireRotationLock(deadline: number): Promise<void> {
+    while (this.rotating) {
+      this.ensureNotTimeout(deadline);
+      await delay();
+    }
+    this.rotating = true;
+  }
+
+  private ensureNotTimeout(deadline: number): void {
+    if (Date.now() > deadline) {
+      throw new Error('Physical rotation timeout.');
+    }
+  }
+
+  private getRightOrientation(current: PhysicalOrientation): PhysicalOrientation {
+    switch (current) {
+      case PhysicalOrientation.ROTATION_0:
+        return PhysicalOrientation.ROTATION_90;
+      case PhysicalOrientation.ROTATION_90:
+        return PhysicalOrientation.ROTATION_180;
+      case PhysicalOrientation.ROTATION_180:
+        return PhysicalOrientation.ROTATION_270;
+      case PhysicalOrientation.ROTATION_270:
+        return PhysicalOrientation.ROTATION_0;
+      default:
+        throw new Error('Current orientation is UNKNOWN.');
+    }
+  }
+
+  /**
+   * 实测坐标：
+   *
+   *          y+
+   *          0°
+   *           ↑
+   *           |
+   * x+ 270° <-+-> 90° x-
+   *           |
+   *           ↓
+   *          180°
+   *          y-
+   *
+   * 因此：angle = atan2(-x, y)
+   */
+  private classifyGravity(data: sensor.GravityResponse): PhysicalOrientation {
+    const planeGravity: number = Math.sqrt(data.x * data.x + data.y * data.y);
+    if (planeGravity < MIN_PLANE_GRAVITY) {
+      return PhysicalOrientation.UNKNOWN;
+    }
+    let angle: number = Math.atan2(-data.x, data.y) * 180 / Math.PI;
+    if (angle < 0) {
+      angle += 360;
+    }
+    const nearestIndex: number = Math.round(angle / 90) % 4;
+    const nearestAngle: number = nearestIndex * 90;
+    let deviation: number = Math.abs(angle - nearestAngle);
+    if (deviation > 180) {
+      deviation = 360 - deviation;
+    }
+    if (deviation > MAX_CARDINAL_DEVIATION_DEG) {
+      return PhysicalOrientation.UNKNOWN;
+    }
+    switch (nearestIndex) {
+      case 0:
+        return PhysicalOrientation.ROTATION_0;
+      case 1:
+        return PhysicalOrientation.ROTATION_90;
+      case 2:
+        return PhysicalOrientation.ROTATION_180;
+      case 3:
+        return PhysicalOrientation.ROTATION_270;
+      default:
+        return PhysicalOrientation.UNKNOWN;
+    }
+  }
+
+  private onGravity = (data: sensor.GravityResponse): void => {
+    this.latestOrientation = this.classifyGravity(data);
+  };
+}
