new file mode 100644
index 0000000..47e8202
--- /dev/null
+++ b/lib/graphic_text_layout/utils/screen_utils.dart
@@ -0,0 +1,82 @@
+import 'package:hadss_adaptive_layout/hadss_adaptive_layout.dart';
+
+/// 屏幕工具类
+///
+/// 提供断点判断、布局计算等屏幕相关工具方法
+class ScreenUtils {
+  /// 判断是否为小屏幕
+  static bool isSmallScreen(WidthBreakpoint widthBreakpoint) {
+    return widthBreakpoint == WidthBreakpoint.xs ||
+        widthBreakpoint == WidthBreakpoint.sm;
+  }
+
+  /// 判断是否为中等屏幕
+  static bool isMediumScreen(WidthBreakpoint widthBreakpoint) {
+    return widthBreakpoint == WidthBreakpoint.md;
+  }
+
+  /// 判断是否为大屏幕
+  static bool isLargeScreen(WidthBreakpoint widthBreakpoint) {
+    return widthBreakpoint == WidthBreakpoint.lg;
+  }
+
+  /// 判断是否为超大屏幕
+  static bool isExtraLargeScreen(WidthBreakpoint widthBreakpoint) {
+    return widthBreakpoint == WidthBreakpoint.xl;
+  }
+
+  /// 判断是否使用水平布局
+  static bool isHorizontalLayout(WidthBreakpoint widthBreakpoint) {
+    return widthBreakpoint == WidthBreakpoint.md ||
+        widthBreakpoint == WidthBreakpoint.lg ||
+        widthBreakpoint == WidthBreakpoint.xl;
+  }
+
+  /// 判断是否为小高度
+  static bool isSmallHeight(HeightBreakpoint heightBreakpoint) {
+    return heightBreakpoint == HeightBreakpoint.sm;
+  }
+
+  /// 基于断点获取图片宽度比例
+  static double getImageWidthRatio(WidthBreakpoint widthBreakpoint) {
+    switch (widthBreakpoint) {
+      case WidthBreakpoint.xl:
+        return 0.5; // xl: 6/12
+      case WidthBreakpoint.lg:
+        return 0.5; // lg: 5/10
+      case WidthBreakpoint.md:
+        return 0.6; // md: 6/10
+      case WidthBreakpoint.sm:
+      case WidthBreakpoint.xs:
+      default:
+        return 1.0; // xs, sm: 4/4
+    }
+  }
+
+  /// 基于断点获取图片宽度
+  static double getImageWidth(WidthBreakpoint widthBreakpoint,
+      HeightBreakpoint heightBreakpoint, double screenWidth) {
+    final isSmall = isSmallScreen(widthBreakpoint);
+
+    if (isSmall) {
+      return double.infinity; // 竖屏小屏时，图片宽度满屏
+    } else {
+      return 0.9 * screenWidth; // 横屏时，图片宽度90%
+    }
+  }
+
+  /// 基于断点获取图片高度
+  static double getImageHeight(WidthBreakpoint widthBreakpoint,
+      HeightBreakpoint heightBreakpoint, double screenHeight) {
+    final isSmall = isSmallScreen(widthBreakpoint);
+
+    if (isSmall) {
+      // 竖版屏时，图片高度占60%，文字占40%
+      // 使用最小高度限制，确保分屏模式下也能正常显示
+      final imageHeight = screenHeight * 0.6; // 60%
+      return imageHeight.clamp(150.0, 400.0); // 限制最小150，最大400
+    } else {
+      return 0.7 * screenHeight; // 70%
+    }
+  }
+}
