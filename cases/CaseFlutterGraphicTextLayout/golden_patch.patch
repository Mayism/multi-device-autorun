new file mode 100644
index 0000000..b2490b2
--- /dev/null
+++ b/lib/graphic_text_layout/utils/breakpoint_constants.dart
@@ -0,0 +1,106 @@
+import 'package:flutter/material.dart';
+import 'package:hadss_adaptive_layout/hadss_adaptive_layout.dart';
+import 'package:graphic_text_layout_ohos/AppThemes.dart';
+
+/// 断点常量和管理工具类
+///
+/// 使用hadss_adaptive_layout的断点系统
+/// WidthBreakpointRange默认值: xs=320, sm=600, md=840, lg=1440, xl=infinity
+class BreakpointConstants {
+  /// 获取背景颜色
+  static Color getBackgroundColor(BuildContext context) {
+    final brightness = MediaQuery.of(context).platformBrightness;
+    return brightness == Brightness.light
+        ? AppThemes.lightTheme.scaffoldBackgroundColor
+        : AppThemes.darkTheme.scaffoldBackgroundColor;
+  }
+
+  /// 获取容器颜色
+  static Color getContainerColor(BuildContext context) {
+    final brightness = MediaQuery.of(context).platformBrightness;
+    return brightness == Brightness.light
+        ? AppThemes.lightTheme.cardColor
+        : AppThemes.darkTheme.cardColor;
+  }
+
+  /// 获取价格颜色
+  static Color getPriceColor(BuildContext context) {
+    return priceColor;
+  }
+
+  /// 获取文本颜色
+  static Color getTextColor(BuildContext context) {
+    final brightness = MediaQuery.of(context).platformBrightness;
+    return brightness == Brightness.light
+        ? Colors.grey[600]!
+        : Colors.grey[400]!;
+  }
+
+  /// 获取促销颜色
+  static Color getPromotionColor(BuildContext context) {
+    return promotionColor;
+  }
+
+  /// 亮色模式下的背景颜色
+  static const Color backgroundColor = Color(0xFFF1F3F5);
+
+  /// 亮色模式下的容器颜色
+  static const Color containerColor = Color(0xFFFFFFFF);
+
+  /// 价格颜色
+  static const Color priceColor = Color(0xFFCF0A2C);
+
+  /// 亮色模式下的文本颜色
+  static const Color textColor = Color(0xFF666666);
+
+  /// 促销颜色
+  static const Color promotionColor = Color(0xFFCF0A2C);
+
+  /// 断点管理器实例
+  static final BreakpointManager _breakpointManager = BreakpointManager();
+
+  /// 初始化断点系统
+  ///
+  /// 返回初始化后的断点数据
+  static Future<BreakpointData> initBreakpoints() async {
+    return await _breakpointManager.init();
+  }
+
+  /// 初始化断点系统（简化方法）
+  ///
+  /// 用于StatelessWidget等需要简化调用的场景
+  static Future<void> initialize() async {
+    await initBreakpoints();
+  }
+
+  /// 获取当前宽度断点
+  static WidthBreakpoint getCurrentWidthBreakpoint() {
+    return _breakpointManager.getWindowWidthBreakpoint();
+  }
+
+  /// 获取当前高度断点
+  static HeightBreakpoint getCurrentHeightBreakpoint() {
+    return _breakpointManager.getWindowHeightBreakpoint();
+  }
+
+  /// 添加断点变化回调
+  ///
+  /// [callback] 断点变化时的回调函数
+  static void addBreakpointCallback(Function(BreakpointData) callback) {
+    _breakpointManager.addBreakpointCallback(callback);
+  }
+
+  /// 移除断点变化回调
+  ///
+  /// [callback] 要移除的回调函数，为null时移除所有回调
+  static void removeBreakpointCallback({Function(BreakpointData)? callback}) {
+    _breakpointManager.removeBreakpointCallback(callback: callback);
+  }
+
+  /// 销毁断点管理器
+  ///
+  /// 清理资源，避免内存泄漏
+  static void dispose() {
+    _breakpointManager.destroy();
+  }
+}
