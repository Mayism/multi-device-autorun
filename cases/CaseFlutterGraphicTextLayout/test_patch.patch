+import { describe, beforeAll, it, expect } from '@ohos/hypium'
+import { Driver } from '@ohos.UiTest'
+import {
+  launchApp,
+  waitAppReady,
+  resetScrollToTop,
+  getStableVpWidth,
+  getWindowRect,
+  getTestIdRect,
+  rectWidth,
+  QA_IMAGE,
+  QA_PRICE
+} from './TestUtils'
+
+/// LG/XL 断点（>=840vp）FailToPass 用例：水平布局 5:5 分栏。
+/// 纯 FailToPass 语义：不做旋转辅助，设备须真实处于 lg/xl 窗口态
+/// （如三折叠全展开横屏 1107vp、平板横屏 1244vp）。
+/// 断点状态由几何断言隐式保证：非 lg/xl 布局的列比例必落在断言带外。
+/// xl（>=1440vp）与 lg 共用 5:5 布局，几何断言相同。
+export default function lgFailToPassTest() {
+  describe('LgFailToPassTest', () => {
+    let driver: Driver = new Driver()
+
+    beforeAll(async () => {
+      driver = await Driver.create()
+      await launchApp(driver)
+      await waitAppReady(driver, 60000)
+      await resetScrollToTop(driver)
+    })
+
+    // 断言 lg/xl 断点下 5:5 分栏：文字列左缘 ≈0.50W（含 8vp 列内边距）、
+    // 图片列右缘 ≈0.49W、图片列贴左
+    it('should_fifty_fifty_columns_on_lg_breakpoint', 0, async () => {
+      const widthVp = await getStableVpWidth(driver)
+      const win = await getWindowRect(driver)
+      const price = await getTestIdRect(driver, QA_PRICE)
+      const img = await getTestIdRect(driver, QA_IMAGE)
+      // 前置存在性：窗口/两个布局锚点任一丢失即失败（屏外或未就绪时 findComponent 返回 null）
+      expect(win !== null && price !== null && img !== null).assertTrue()
+      if (win === null || price === null || img === null) {
+        return
+      }
+      const w = rectWidth(win)
+      const textLeftRatio = (price.left - win.left) / w
+      const imgRightRatio = (img.right - win.left) / w
+      console.info(`LgFailToPassTest: widthVp=${widthVp.toFixed(1)} ` +
+        `textLeftRatio=${textLeftRatio.toFixed(3)} imgRightRatio=${imgRightRatio.toFixed(3)}`)
+      // 文字列左缘比例：Row flex 5:5 → 列边界 0.5W，价格卡片再 +8px 列内边距，
+      // 名义值 (0.5W+8)/W ≈ 0.510；带宽 [0.48, 0.56] 吸收取整与边距，
+      // 与 md 档（0.610）相差 0.1 远大于带宽，md/lg 混档必失败
+      expect(textLeftRatio >= 0.48 && textLeftRatio <= 0.56).assertTrue()
+      // 图片列右缘比例：0.5W − 8px 右内边距，名义值 ≈0.49；
+      // 与文字列左缘从左右两方向夹逼 0.5W 列边界
+      expect(imgRightRatio >= 0.45 && imgRightRatio <= 0.55).assertTrue()
+      // 图片列贴左：图片列是 Row 首列，左缘仅 16px 内边距（≈0.02W）；
+      // 若列序颠倒（文字在左）此断言失败
+      expect(img.left - win.left < 0.05 * w).assertTrue()
+    })
+  })
+}
