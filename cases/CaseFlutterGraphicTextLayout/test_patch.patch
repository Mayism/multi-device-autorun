+import { describe, beforeAll, it, expect } from '@ohos/hypium'
+import { Driver } from '@ohos.UiTest'
+import {
+  launchApp,
+  waitAppReady,
+  resetScrollToTop,
+  getStableVpWidth,
+  getWindowRect,
+  getTestIdRect,
+  rectWidth,
+  QA_IMAGE,
+  QA_PRICE
+} from './TestUtils'
+
+/// SM 及以下断点（<600vp）PassToPass 用例：垂直布局（图上文下、文字整宽）。
+/// 运行条件：设备本就处于窄窗口态（手机竖屏/折叠态，无法编程收窄）。
+/// 断点状态由几何断言隐式保证：分栏布局（文字列左缘≈0.6W）必落在断言带外。
+export default function smPassToPassTest() {
+  describe('SmPassToPassTest', () => {
+    let driver: Driver = new Driver()
+
+    beforeAll(async () => {
+      driver = await Driver.create()
+      await launchApp(driver)
+      await waitAppReady(driver, 60000)
+      await resetScrollToTop(driver)
+    })
+
+    // 断言 sm 及以下断点为垂直布局：文字整宽显示（非分栏）且图上文下
+    it('should_vertical_layout_on_sm_breakpoint', 0, async () => {
+      const widthVp = await getStableVpWidth(driver)
+      const win = await getWindowRect(driver)
+      const price = await getTestIdRect(driver, QA_PRICE)
+      const img = await getTestIdRect(driver, QA_IMAGE)
+      // 前置存在性：窗口/锚点任一丢失即失败（未就绪或屏外时 findComponent 返回 null）
+      expect(win !== null && price !== null && img !== null).assertTrue()
+      if (win === null || price === null || img === null) {
+        return
+      }
+      console.info(`SmPassToPassTest: widthVp=${widthVp.toFixed(1)} ` +
+        `textLeft=${price.left - win.left}px imgBottom=${img.bottom} priceTop=${price.top}`)
+      // 垂直布局判定：价格卡片左缘 ≈ 页面 8px 内边距（≈0.01W）；若误渲染水平分栏
+      // 会跳到 ≈0.6W，取 0.3W 居中分界，两种布局均可明确判定
+      expect(price.left - win.left < 0.3 * rectWidth(win)).assertTrue()
+      // 图上文下顺序：图片区整体位于价格区上方，+4px 容渲染取整
+      expect(img.bottom <= price.top + 4).assertTrue()
+    })
+  })
+}
diff --git a/ohos/entry/src/ohosTest/ets/test/TestUtils.ets b/ohos/entry/src/ohosTest/ets/test/TestUtils.ets
new file mode 100644
index 0000000..07fcd7b
--- /dev/null
+++ b/ohos/entry/src/ohosTest/ets/test/TestUtils.ets
@@ -0,0 +1,150 @@
+import { Driver, ON, Component, Rect, MatchPattern } from '@ohos.UiTest'
+import display from '@ohos.display'
+import abilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry'
+import Want from '@ohos.app.ability.Want'
+
+export const BUNDLE_NAME = 'com.example.graphic_text_layout_ohos'
+export const ABILITY_NAME = 'EntryAbility'
+
+/// Flutter 组件 QA 定位标记（Dart 侧 Semantics(label:) 标注：
+/// qa_image_container / qa_price_section / qa_details_section）
+export const QA_IMAGE = 'qa_image_container'
+export const QA_PRICE = 'qa_price_section'
+export const QA_DETAILS = 'qa_details_section'
+
+/// Flutter 组件 QA 定位默认方式：Dart 侧 Semantics(label: 'qa_xxx') 标注，
+/// 引擎桥接 label → 无障碍节点 text 属性，故底层走 ON.text(CONTAINS)。
+/// 语义合并会把标记子树的静态文本并入节点（text 为换行拼接块），
+/// 精确匹配必失败，必须 CONTAINS。
+/// findComponent 找不到返回 null 而非抛异常，必须判空。
+async function findByTestId(driver: Driver, testId: string): Promise<Component | null> {
+  try {
+    const component = await driver.findComponent(ON.text(testId, MatchPattern.CONTAINS))
+    return component !== null && component !== undefined ? component : null
+  } catch {
+    return null
+  }
+}
+
+export async function getTestIdRect(driver: Driver, testId: string): Promise<Rect | null> {
+  const component = await findByTestId(driver, testId)
+  return component !== null ? await component.getBounds() : null
+}
+
+/// 当前应用窗口矩形（px）：经 uitest 按 bundleName 取应用窗口。
+/// 不依赖 display.rotation / window API（旋转期间与实际宽高不同步，实测不可信）。
+export async function getWindowRect(driver: Driver): Promise<Rect | null> {
+  try {
+    const win = await driver.findWindow({ bundleName: BUNDLE_NAME })
+    if (win === null || win === undefined) {
+      return null
+    }
+    return await win.getBounds()
+  } catch {
+    return null
+  }
+}
+
+function getDensity(): number {
+  return display.getDefaultDisplaySync().densityPixels
+}
+
+async function getWindowVpWidth(driver: Driver): Promise<number> {
+  const rect = await getWindowRect(driver)
+  if (rect === null) {
+    return -1
+  }
+  return (rect.right - rect.left) / getDensity()
+}
+
+/// 窗口宽度（vp，仅用于 console.info 排查日志）：连续两次读数差 <1vp 才采信，
+/// 避免把旋转/窗口变化过渡期的瞬态值当真实宽度
+export async function getStableVpWidth(driver: Driver): Promise<number> {
+  let prev = -1
+  for (let i = 0; i < 20; i++) {
+    const w = await getWindowVpWidth(driver)
+    if (w > 0 && prev > 0 && Math.abs(w - prev) < 1) {
+      return w
+    }
+    if (w > 0) {
+      prev = w
+    }
+    await driver.delayMs(500)
+  }
+  return prev
+}
+
+export function rectWidth(r: Rect): number {
+  return r.right - r.left
+}
+
+export function rectHeight(r: Rect): number {
+  return r.bottom - r.top
+}
+
+/// 垂直上滑（px）：内容向上滚动；swipeDownAt 反向回到顶部方向
+export async function swipeUpAt(driver: Driver, centerX: number, centerY: number,
+  distancePx: number): Promise<void> {
+  await driver.swipe(centerX, centerY, centerX, centerY - distancePx)
+}
+
+export async function swipeDownAt(driver: Driver, centerX: number, centerY: number,
+  distancePx: number): Promise<void> {
+  await driver.swipe(centerX, centerY, centerX, centerY + distancePx)
+}
+
+/// 滚动复位：覆盖垂直布局（整页）与水平布局（文字列），消除前序用例遗留滚动位置。
+/// 屏外组件 findComponent 找不到（返回 null），几何断言前必须回到已知状态。
+/// 0.8W 为水平布局文字列中轴（md 列区 0.6-1.0 / lg 列区 0.5-1.0 的公共内部点）。
+export async function resetScrollToTop(driver: Driver): Promise<void> {
+  const win = await getWindowRect(driver)
+  if (win === null) {
+    return
+  }
+  const cy = Math.floor((win.top + win.bottom) / 2)
+  const dist = Math.floor(rectHeight(win) * 0.4)
+  const centerX = Math.floor((win.left + win.right) / 2)
+  const textColX = Math.floor(win.left + 0.8 * rectWidth(win))
+  await swipeDownAt(driver, centerX, cy, dist)
+  await driver.delayMs(400)
+  await swipeDownAt(driver, textColX, cy, dist)
+  await driver.delayMs(600)
+}
+
+/// 冷启动就绪：页面锚点可定位 且 应用窗口宽度可读。
+/// 实测重装/冷启后 Flutter 引擎 + 语义桥接就绪可达 30s+，就绪前读窗口必得 -1/null。
+export async function waitAppReady(driver: Driver, timeoutMs: number): Promise<boolean> {
+  let waited = 0
+  while (waited <= timeoutMs) {
+    const price = await findByTestId(driver, QA_PRICE)
+    const w = await getWindowVpWidth(driver)
+    if (price !== null && w > 0) {
+      return true
+    }
+    await driver.delayMs(1000)
+    waited += 1000
+  }
+  return false
+}
+
+/// 启动应用（不强制杀进程：entry_test 与主应用同 bundle，
+/// aa force-stop 自身 bundle 会杀死测试进程自身）
+export async function launchApp(driver: Driver): Promise<void> {
+  const delegator = abilityDelegatorRegistry.getAbilityDelegator()
+  const want: Want = {
+    bundleName: BUNDLE_NAME,
+    abilityName: ABILITY_NAME
+  }
+  let started = false
+  for (let attempt = 1; attempt <= 3 && !started; attempt++) {
+    await new Promise<void>((resolve) => {
+      delegator.startAbility(want, (err) => {
+        started = err === undefined || err === null || err.code === 0
+        resolve()
+      })
+    })
+    if (!started) {
+      await driver.delayMs(1000)
+    }
+  }
+}
