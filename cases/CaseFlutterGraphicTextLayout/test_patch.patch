+import { describe, beforeAll, it, expect } from '@ohos/hypium'
+import { Driver } from '@ohos.UiTest'
+import {
+  launchApp,
+  waitAppReady,
+  resetScrollToTop,
+  getStableVpWidth,
+  getWindowRect,
+  getTestIdRect,
+  rectWidth,
+  QA_IMAGE,
+  QA_PRICE
+} from './TestUtils'
+
+/// MD 断点（600-840vp）FailToPass 用例：水平布局 Row + flex 6:4 分栏（图左文右）。
+/// 纯 FailToPass 语义：不做旋转辅助，设备须真实处于 md 窗口态
+/// （如折叠屏展开竖屏 707vp、平板竖屏 800vp）。
+/// 断点状态由几何断言隐式保证：lg 档（文字列左缘≈0.51）/垂直档（≈0.01）必落在断言带外。
+export default function mdFailToPassTest() {
+  describe('MdFailToPassTest', () => {
+    let driver: Driver = new Driver()
+
+    beforeAll(async () => {
+      driver = await Driver.create()
+      await launchApp(driver)
+      await waitAppReady(driver, 60000)
+      await resetScrollToTop(driver)
+    })
+
+    // 断言 md 断点下 6:4 分栏：图左（flex 6）文右（flex 4），
+    // 文字列左缘 ≈0.60W（含 8vp 列内边距）、图片列右缘 ≈0.59W、图片列贴左
+    it('should_sixty_forty_columns_on_md_breakpoint', 0, async () => {
+      const widthVp = await getStableVpWidth(driver)
+      const win = await getWindowRect(driver)
+      const price = await getTestIdRect(driver, QA_PRICE)
+      const img = await getTestIdRect(driver, QA_IMAGE)
+      // 前置存在性：窗口/两个布局锚点任一丢失即失败（屏外或未就绪时 findComponent 返回 null）
+      expect(win !== null && price !== null && img !== null).assertTrue()
+      if (win === null || price === null || img === null) {
+        return
+      }
+      const w = rectWidth(win)
+      const textLeftRatio = (price.left - win.left) / w
+      const imgRightRatio = (img.right - win.left) / w
+      console.info(`MdFailToPassTest: widthVp=${widthVp.toFixed(1)} ` +
+        `textLeftRatio=${textLeftRatio.toFixed(3)} imgRightRatio=${imgRightRatio.toFixed(3)}`)
+      // 文字列左缘比例：Row flex 6:4 → 列边界 0.6W，价格卡片再 +8px 列内边距，
+      // 名义值 (0.6W+8)/W ≈ 0.610；带宽 [0.58, 0.65] 吸收取整与断点内宽度漂移，
+      // 与 lg 档（0.51）/垂直档（≈0.01）的间距远大于带宽，错档必失败
+      expect(textLeftRatio >= 0.58 && textLeftRatio <= 0.65).assertTrue()
+      // 图片列右缘比例：0.6W − 8px 右内边距，名义值 ≈0.589；与文字列左缘
+      // 互相印证列边界位置（两断言从左右两个方向夹逼 0.6W）
+      expect(imgRightRatio >= 0.55 && imgRightRatio <= 0.62).assertTrue()
+      // 图片列贴左：图片列是 Row 首列，左缘仅 16px 内边距（≈0.02W）；
+      // 若列序颠倒（文字在左）此断言失败
+      expect(img.left - win.left < 0.05 * w).assertTrue()
+    })
+  })
+}
