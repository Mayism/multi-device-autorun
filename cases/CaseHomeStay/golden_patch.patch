+          .width(Constants.IMAGE_WIDTH)
+          .height(Constants.IMAGE_HEIGHT)
+          .borderRadius(Constants.BORDER_RADIUS_8)
+          .objectFit(ImageFit.Fill)
+      }
+
+      Column() {
+        Text(listItem.title)
+          .textStyles()
+          .fontWeight(FontWeight.Medium)
+          .fontColor($r('sys.color.font_primary'))
+
