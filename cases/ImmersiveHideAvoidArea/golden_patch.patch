@@ -67,6 +67,29 @@ export class WindowUtil {
     }
   }
 
+  /**
+   * 进入/退出「避让区隐藏」沉浸态。
+   * hidden = true：窗口置为全屏布局，状态栏与导航条（手势条）隐藏，避让区归零，内容铺满整屏。
+   * hidden = false：恢复状态栏与导航条及默认布局，避免影响其他页面。
+   */
+  setAvoidAreaHidden(hidden: boolean): void {
+    this.mainWindow.setWindowLayoutFullScreen(hidden)
+      .then(() => {
+        this.mainWindow.setSpecificSystemBarEnabled('status', !hidden)
+          .catch((error: BusinessError) => {
+            hilog.error(0x0000, 'TestLog', `Failed to set status bar. Code: ${error.code}, message: ${error.message}`);
+          });
+        this.mainWindow.setSpecificSystemBarEnabled('navigationIndicator', !hidden)
+          .catch((error: BusinessError) => {
+            hilog.error(0x0000, 'TestLog',
+              `Failed to set navigation indicator. Code: ${error.code}, message: ${error.message}`);
+          });
+      })
+      .catch((error: BusinessError) => {
+        hilog.error(0x0000, 'TestLog', `Failed to set full screen. Code: ${error.code}, message: ${error.message}`);
+      });
+  }
+
 }
 
