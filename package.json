{
  "name": "multi-device-autorun",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run build:whitebox",
    "build": "npm run build:whitebox",
    "build:whitebox": "tsc -p src/pyautorun/whitebox_eval/ark_analyzer/tsconfig.arkfacts.json",
    "autorun": "python3 -m pyautorun.cli",
    "ohostest:case": "python3 -m pyautorun.ohostest_case",
    "ohostest:matrix": "python3 -m pyautorun.ohostest_matrix",
    "deploy:fold": "python3 -m pyautorun.deploy_fold",
    "whitebox:start": "python3 -m pyautorun.whitebox_api",
    "whitebox:evaluate": "python3 -m pyautorun.whitebox_local",
    "whitebox:remote": "python3 -m pyautorun.whitebox_remote",
    "whitebox:api": "python3 -m pyautorun.whitebox_api",
    "whitebox:dev": "python3 -m pyautorun.whitebox_local",
    "test": "npm run test:python && npm run test:whitebox",
    "test:autorun": "npm run test:python",
    "test:ohostest": "python3 -m unittest pyautorun.tests.test_ohostest_case -q",
    "test:whitebox": "npm run build:whitebox",
    "test:python": "python3 -m unittest discover -s src/pyautorun/tests -q",
    "lint": "npm run build:whitebox"
  },
  "dependencies": {
    "arkanalyzer": "^1.0.90"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
